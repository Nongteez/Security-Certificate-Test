/* V3 Presentation Viewer Shell & Scoped Presentation Tokens */
.learning-viewer {
  --viewer-bg: #0d1117;
  --viewer-toolbar-bg: #161b22;
  --viewer-toolbar-border: #21262d;
  --viewer-slide-border: rgba(255, 255, 255, 0.08);
  --viewer-slide-shadow: 0 16px 44px -8px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05);
  --viewer-divider-color: #2d333b;
}

html[data-theme="light"] .learning-viewer {
  --viewer-bg: #edf1f7;
  --viewer-toolbar-bg: #ffffff;
  --viewer-toolbar-border: #d0d7de;
  --viewer-slide-border: rgba(0, 0, 0, 0.08);
  --viewer-slide-shadow: 0 14px 36px -8px rgba(15, 23, 42, 0.12), 0 2px 6px -1px rgba(15, 23, 42, 0.04);
  --viewer-divider-color: #d0d7de;
}

html[data-theme="dark"] .learning-viewer {
  --viewer-bg: #0d1117;
  --viewer-toolbar-bg: #161b22;
  --viewer-toolbar-border: #21262d;
  --viewer-slide-border: rgba(255, 255, 255, 0.08);
  --viewer-slide-shadow: 0 16px 44px -8px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05);
  --viewer-divider-color: #2d333b;
}

.app.learning-viewer-host { width: 100%; max-width: none; margin: 0; padding: 0; }
.learning-screen.learning-viewer {
  width: 100%;
  max-width: none;
  height: 100dvh;
  min-height: 100dvh;
  margin: 0;
  padding: 16px;
  gap: 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--viewer-bg);
  color: var(--text);
  overflow: hidden;
}
.learning-viewer .presentation-workspace {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  width: 100%;
  height: auto;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  background: transparent;
  color: var(--text);
  overflow: hidden;
}
.learning-viewer .presentation-stage-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  width: 100%;
  height: 100%;
}
.learning-viewer .learning-slide {
  flex: none;
  aspect-ratio: 16 / 9;
  max-width: none;
  min-width: 0;
  min-height: 0;
  margin: 0;
  box-sizing: border-box;
  padding: clamp(20px, 2.4vw, 38px);
  border: 1px solid var(--viewer-slide-border);
  border-radius: 12px;
  box-shadow: var(--viewer-slide-shadow);
  background: #ffffff;
  color: #0f172a;
  overflow-y: auto;
  font-size: var(--viewer-body-size, 16px);
  line-height: 1.55;
  display: flex;
  flex-direction: column;
}
.learning-viewer .learning-slide-title {
  margin: 0 0 clamp(10px, 1.2vw, 16px);
  padding: 0 0 clamp(6px, 0.8vw, 10px);
  font-size: var(--viewer-title-size, 30px);
  line-height: 1.25;
  border-bottom: 2px solid var(--slide-blue-border, #e2e8f0);
}
.learning-viewer .learning-slide-body {
  flex: 1 1 auto;
  min-height: 0;
  gap: clamp(8px, 1.1vw, 14px);
  display: flex;
  flex-direction: column;
}
.learning-viewer .learning-slide p,
.learning-viewer .learning-slide li {
  font-size: var(--viewer-body-size, 16px);
  line-height: 1.55;
}
.learning-viewer .learning-slide [lang="th"] { line-height: 1.65; }
.learning-viewer .learning-slide .learning-language { font-size: inherit; }
.learning-viewer .learning-hero-deck,
.learning-viewer .learning-pillars-deck,
.learning-viewer .learning-incident-deck,
.learning-viewer .learning-scenario-deck { height: 100%; max-height: 100%; }
.learning-viewer .presentation-workspace:not(:fullscreen) .learning-slide:has(.learning-hero-deck, .learning-pillars-deck, .learning-incident-deck, .learning-scenario-deck) { overflow-y: hidden; }

/* Phase 3 Presentation Design Foundation — Prototype 1: Hero Intro (Slide 1) */
.learning-viewer .learning-hero-deck {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(16px, 2.5vw, 36px);
  height: 100%;
  align-items: center;
  box-sizing: border-box;
}
.learning-viewer .hero-content-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: clamp(10px, 1.4vw, 18px);
  min-width: 0;
}
.learning-viewer .hero-eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--slide-blue, #2563eb);
}
.learning-viewer .hero-headline {
  margin: 0;
  font-size: clamp(22px, 2.2vw, 29px);
  font-weight: 800;
  line-height: 1.25;
  color: #0f172a;
  letter-spacing: -0.015em;
}
.learning-viewer .hero-lead-text {
  margin: 0;
  font-size: clamp(14px, 1.05vw, 16px);
  line-height: 1.6;
  color: #334155;
}
.learning-viewer .hero-principle-card {
  background: linear-gradient(135deg, #f0fdf4 0%, #eff6ff 100%);
  border: 1.5px solid #bfdbfe;
  border-left: 4px solid #2563eb;
  border-radius: 10px;
  padding: clamp(10px, 1.2vw, 14px) clamp(12px, 1.5vw, 18px);
  display: flex;
  flex-direction: column;
  gap: 6px;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.05);
}
.learning-viewer .hero-principle-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 13px;
  color: #1e3a8a;
}
.learning-viewer .hero-principle-icon {
  font-size: 16px;
}
.learning-viewer .hero-principle-title {
  font-weight: 700;
}
.learning-viewer .hero-principle-text {
  margin: 0;
  font-size: clamp(12.5px, 0.95vw, 14px);
  line-height: 1.5;
  color: #1e293b;
}
.learning-viewer .hero-visual-col {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-width: 0;
}
.learning-viewer .hero-emblem-card {
  width: 100%;
  max-width: 380px;
  background: radial-gradient(circle at 50% 25%, #1e293b 0%, #0f172a 100%);
  border: 1.5px solid #334155;
  border-radius: 16px;
  padding: clamp(14px, 1.6vw, 20px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.25);
  color: #f8fafc;
}
.learning-viewer .hero-triad-svg {
  width: 100%;
  max-width: 320px;
  height: auto;
  max-height: 220px;
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
}
.learning-viewer .hero-triad-pills {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.learning-viewer .hero-mini-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 10px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 11px;
  line-height: 1.35;
}
.learning-viewer .hero-mini-pill.tone-blue { border-color: rgba(59, 130, 246, 0.4); }
.learning-viewer .hero-mini-pill.tone-green { border-color: rgba(16, 185, 129, 0.4); }
.learning-viewer .hero-mini-pill.tone-amber { border-color: rgba(245, 158, 11, 0.4); }
.learning-viewer .hero-pill-badge {
  width: 18px;
  height: 18px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 10px;
  color: #fff;
  flex-shrink: 0;
}
.learning-viewer .hero-mini-pill.tone-blue .hero-pill-badge { background: #2563eb; }
.learning-viewer .hero-mini-pill.tone-green .hero-pill-badge { background: #059669; }
.learning-viewer .hero-mini-pill.tone-amber .hero-pill-badge { background: #d97706; }
.learning-viewer .hero-pill-label {
  color: #e2e8f0;
  font-size: 11px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Phase 3 Presentation Design Foundation — Prototype 2: Concept Diagram (Slide 2) */
.learning-viewer .pillars-diagram-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 4px 12px;
  margin-bottom: 4px;
}
.learning-viewer .pillars-diagram-svg {
  width: 100%;
  max-width: 680px;
  height: 48px;
  display: block;
}

/* Phase 3 Presentation Design Foundation — Prototype 3: Process Timeline (Slide 6) */
.learning-viewer .incident-timeline-track {
  width: 100%;
  height: 6px;
  background: linear-gradient(90deg, #3b82f6 0%, #10b981 50%, #f59e0b 100%);
  border-radius: 9999px;
  margin: 2px 0 6px;
  opacity: 0.85;
}
.learning-viewer .stage-time-tag {
  font-size: 0.72rem;
  font-weight: 700;
  color: #1e3a8a;
  background: #eff6ff;
  padding: 2px 8px;
  border-radius: 4px;
  border: 1px solid #bfdbfe;
}
.learning-viewer .incident-connector {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  user-select: none;
  flex-shrink: 0;
}
.learning-viewer .connector-arrow {
  font-size: clamp(1rem, 1.3vw, 1.35rem);
  color: #64748b;
}
.learning-viewer .connector-flow-text {
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
  background: #f8fafc;
  padding: 1px 5px;
  border-radius: 3px;
  border: 1px solid #e2e8f0;
}

/* Layout 1 compact slide refinements */
.learning-viewer [data-layout="title-bullets"] .learning-slide-body > p:first-child {
  padding: clamp(8px, 1.1vw, 12px) clamp(12px, 1.4vw, 16px);
  font-size: 1.02em;
  line-height: 1.55;
}
.learning-viewer [data-layout="title-bullets"] .learning-slide-body > ul {
  gap: clamp(6px, 0.8vw, 10px);
}
.learning-viewer [data-layout="title-bullets"] .learning-slide-body > ul > li {
  padding: clamp(8px, 1vw, 12px) clamp(10px, 1.2vw, 14px);
}
.learning-viewer [data-layout="title-bullets"] .learning-slide-body > p:last-child {
  padding: clamp(8px, 1vw, 12px) clamp(10px, 1.2vw, 14px);
  font-size: 0.92em;
}

.learning-viewer .presentation-workspace[data-view="reading"] {
  display: block;
  flex: 1 1 auto;
  height: 100%;
  min-height: 0;
  overflow-y: auto;
  padding: 12px 0 24px;
}
.learning-viewer .presentation-workspace[data-view="reading"] .presentation-stage-slot {
  display: block;
  height: auto;
}
.learning-viewer .presentation-workspace[data-view="reading"] .learning-slide { width: 100% !important; max-width: 1040px; height: auto !important; margin: 0 auto; aspect-ratio: auto; font-size: 19px; }
.learning-viewer .presentation-workspace[data-view="reading"] .learning-slide p,
.learning-viewer .presentation-workspace[data-view="reading"] .learning-slide li { font-size: 19px; }
.learning-viewer .learning-table-scroll { overflow: visible; }
.learning-viewer .learning-slide table { table-layout: fixed; }
.learning-viewer .learning-slide :is(td, th) { overflow-wrap: anywhere; }

/* Table spacing refinement: optimize cell padding to eliminate 14px vertical overflow on desktop 1440x900 */
.learning-viewer [data-layout="summary-grid"] .learning-table-scroll th,
.learning-viewer [data-layout="summary-grid"] .learning-table-scroll td,
.learning-viewer .learning-table-scroll th,
.learning-viewer .learning-table-scroll td {
  padding: 8px 14px;
  line-height: 1.5;
}
.learning-viewer [data-layout="summary-grid"] .learning-slide-body {
  gap: 10px;
}
.learning-viewer [data-layout="summary-grid"] caption {
  margin-bottom: 6px;
}

/* Three-Zone Presentation Toolbar */
.learning-viewer .viewer-toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  flex: 0 0 56px;
  height: 56px;
  min-height: 56px;
  max-height: 56px;
  width: 100%;
  padding: 0 16px;
  margin: 0;
  flex-wrap: nowrap;
  z-index: 20;
  box-sizing: border-box;
  border-radius: 12px;
  background: var(--viewer-toolbar-bg);
  border: 1px solid var(--viewer-toolbar-border);
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
  color: var(--text);
  position: relative;
}
.learning-viewer .viewer-toolbar .learning-lesson-title {
  flex: 0 1 auto;
  margin: 0;
}

/* Control base buttons */
.learning-viewer .viewer-control {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-height: 42px;
  height: 42px;
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  color: var(--text);
  font: inherit;
  font-size: 13.5px;
  cursor: pointer;
  white-space: nowrap;
  box-sizing: border-box;
  transition: all 0.16s ease;
}
.learning-viewer .viewer-control:hover:not(:disabled) {
  background: var(--panel-hover);
  border-color: var(--line-hover);
  color: var(--text);
}
.learning-viewer .viewer-control:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}
.learning-viewer .viewer-control:disabled {
  opacity: 0.38;
  cursor: not-allowed;
  pointer-events: none;
}

/* Zone 1: Left Context */
.learning-viewer .viewer-zone-left {
  display: flex;
  align-items: center;
  justify-self: start;
  min-width: 0;
  gap: 8px;
}
.learning-viewer .viewer-back-btn {
  min-width: 42px;
  width: 42px;
  height: 42px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-color: transparent;
  color: var(--text-dim);
  border-radius: 8px;
}
.learning-viewer .viewer-back-btn:hover:not(:disabled) {
  background: var(--panel-hover);
  border-color: var(--line-hover);
  color: var(--blue);
}
.learning-viewer .viewer-divider {
  display: inline-block;
  width: 1px;
  height: 20px;
  background: var(--viewer-divider-color);
  flex-shrink: 0;
  margin: 0 4px;
}
.learning-viewer .viewer-lesson-context {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  line-height: 1.2;
  overflow: hidden;
}
.learning-viewer .viewer-lesson-kicker {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2px;
}
.learning-viewer .viewer-lesson-heading {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--text);
  margin: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  letter-spacing: -0.01em;
  line-height: 1.25;
}

/* Zone 2: Center Navigation */
.learning-viewer .viewer-zone-center {
  display: flex;
  align-items: center;
  justify-self: center;
  gap: 6px;
  margin: 0;
}
.learning-viewer .viewer-nav-btn {
  width: 42px;
  min-width: 42px;
  height: 42px;
  min-height: 42px;
  padding: 0;
  font-size: 20px;
  font-weight: 600;
  line-height: 1;
}
.learning-viewer .learning-counter {
  min-width: 64px;
  text-align: center;
  font-size: 13.5px;
  font-weight: 600;
  font-family: 'JetBrains Mono', monospace;
  font-variant-numeric: tabular-nums;
  color: var(--text);
  padding: 0 6px;
}
.learning-viewer .viewer-complete-btn {
  min-height: 42px;
  padding: 8px 16px;
  background: var(--blue);
  color: #ffffff;
  border-color: var(--blue);
  font-weight: 600;
  font-size: 13px;
  border-radius: 8px;
}
.learning-viewer .viewer-complete-btn:hover:not(:disabled) {
  background: var(--blue-hover);
  border-color: var(--blue-hover);
}
.learning-viewer .viewer-exit-btn {
  min-height: 42px;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
}

/* Zone 3: Right Tools */
.learning-viewer .viewer-zone-right {
  display: flex;
  align-items: center;
  justify-self: end;
  position: relative;
}
.learning-viewer .viewer-utilities {
  display: flex;
  align-items: center;
  gap: 6px;
}
.learning-viewer .viewer-utilities .lang-toggle {
  display: inline-flex;
  align-items: center;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 2px;
  gap: 2px;
  height: 42px;
  box-sizing: border-box;
}
.learning-viewer .viewer-utilities .lang-btn {
  min-height: 36px;
  height: 36px;
  padding: 0 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 700;
  font-family: 'JetBrains Mono', monospace;
  border: none;
}
.learning-viewer .viewer-btn-tool {
  min-height: 42px;
  height: 42px;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
}
.learning-viewer .viewer-btn-icon,
.learning-viewer [data-action="fullscreen"],
.learning-viewer [data-action="help"] {
  width: 42px;
  min-width: 42px;
  padding: 0;
  font-size: 16px;
}
.learning-viewer .viewer-utilities .theme-toggle {
  width: 42px;
  height: 42px;
  border-radius: 8px;
}

.learning-viewer .viewer-notice {
  flex: 0 0 auto; margin: 0; padding: 10px 14px;
  color: var(--text-dim); background: var(--panel);
  border: 1px solid var(--line); border-radius: 8px;
  font-size: 14px; line-height: 1.6;
}
.learning-viewer .viewer-notice[hidden] {
  display: none !important;
}

/* Keyboard shortcuts modal dialog */
.learning-viewer .viewer-help-overlay {
  position: fixed;
  inset: 0;
  z-index: 2200;
  display: grid;
  place-items: center;
  padding: 16px;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
.learning-viewer .viewer-help-dialog {
  width: min(100%, 420px);
  border: 1px solid var(--viewer-toolbar-border, var(--line));
  border-radius: 14px;
  background: var(--viewer-toolbar-bg, var(--panel));
  box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.55);
  color: var(--text);
  padding: 22px 24px;
  box-sizing: border-box;
}
.learning-viewer .viewer-help-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}
.learning-viewer .viewer-help-title {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.learning-viewer .viewer-help-close {
  min-width: 32px;
  width: 32px;
  height: 32px;
  min-height: 32px;
  padding: 0;
  font-size: 15px;
  border-radius: 6px;
}
.learning-viewer .viewer-help-content {
  display: grid;
  gap: 0;
}
.learning-viewer .viewer-shortcut-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--viewer-divider-color, var(--line));
  gap: 16px;
}
.learning-viewer .viewer-shortcut-row:last-child {
  border-bottom: none;
  padding-bottom: 2px;
}
.learning-viewer .viewer-shortcut-desc {
  font-size: 13.5px;
  color: var(--text);
  font-weight: 500;
}
.learning-viewer .viewer-shortcut-keys {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}
.learning-viewer .viewer-shortcut-sep {
  font-size: 11.5px;
  color: var(--text-dim);
}
.learning-viewer .viewer-kbd {
  display: inline-block;
  padding: 3px 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  font-weight: 600;
  border-radius: 6px;
  background: var(--panel-2, rgba(255, 255, 255, 0.08));
  border: 1px solid var(--line, rgba(255, 255, 255, 0.15));
  color: var(--text);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
}

/* Fullscreen presentation layout */
.learning-viewer .presentation-workspace:fullscreen {
  width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start;
  padding: 8px; gap: 8px; background: #000000;
}
.learning-viewer .presentation-workspace:fullscreen .presentation-stage-slot { order: 1; }
.learning-viewer .presentation-workspace:fullscreen .viewer-notice { order: 2; }
.learning-viewer .presentation-workspace:fullscreen .viewer-toolbar {
  order: 3; display: flex; justify-content: center; position: relative; top: auto; margin: 0 auto;
  width: auto; max-width: fit-content; border-radius: 12px;
  background: rgba(22, 27, 34, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
