/* --------------------------------------------------------------------------
   Mobile Reflow for All CIA Slides
   -------------------------------------------------------------------------- */
@media (max-width: 719px) {
  .learning-viewer .cia-presentation {
    height: auto;
    padding: 20px 16px;
    gap: 18px;
    overflow: visible;
  }
  .learning-viewer .cia-pres-title {
    font-size: 22px;
  }
  .learning-viewer .cia-pres-subtitle {
    font-size: 14.5px;
  }
  .learning-viewer .cia-pillars-presentation .pillars-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .learning-viewer .cia-split-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .learning-viewer .incident-stages-row {
    flex-direction: column;
    gap: 12px;
  }
  .learning-viewer .incident-connector {
    transform: rotate(90deg);
    margin: 4px auto;
  }
  .learning-viewer .scenario-options-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .learning-viewer .evidence-row {
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .learning-viewer .cia-matrix-wrapper {
    overflow-x: auto;
  }
  .learning-viewer .cia-synthesis-table {
    min-width: 540px;
  }
}

