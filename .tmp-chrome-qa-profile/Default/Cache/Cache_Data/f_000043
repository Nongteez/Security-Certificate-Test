 */

/** Helper to create bilingual elements with proper lang attribute */
function createBilingualElement(doc, tag, className, textObj, language) {
  const isThai = language === 'th';
  const el = element(doc, tag, className, textObj[isThai ? 'th' : 'en']);
  el.setAttribute('lang', isThai ? 'th' : 'en');
  return el;
}

/** Slide 2: The Three Pillars of Information Security (Pillars Architectural Presentation) */
export function renderPillars(host, { slide, language }) {
  const doc = host.ownerDocument;
  const isThai = language === 'th';
  const visual = slide.visual || {};

  const deck = element(doc, 'div', 'cia-presentation cia-pillars-presentation learning-pillars-deck');
  deck.setAttribute('lang', isThai ? 'th' : 'en');

  // Header Zone
  const header = element(doc, 'header', 'cia-pres-header');
  const eyebrow = element(doc, 'span', 'cia-pres-eyebrow', isThai ? 'โครงสร้างพื้นฐานความมั่นคงปลอดภัย' : 'FOUNDATIONAL ARCHITECTURE');
  eyebrow.setAttribute('lang', isThai ? 'th' : 'en');
  const headline = element(doc, 'h3', 'cia-pres-title', slide.title[isThai ? 'th' : 'en']);
  headline.setAttribute('lang', isThai ? 'th' : 'en');
  header.append(eyebrow, headline);
  deck.append(header);

  // Architectural Central Triad Diagram Bar
  const diagramBar = element(doc, 'div', 'pillars-diagram-bar');
  const triadImg = element(doc, 'img', 'pillars-diagram-svg');
  triadImg.setAttribute('src', new URL('../../../assets/learning/cia-pillars-triad.svg', import.meta.url).href);
  triadImg.setAttribute('alt', isThai ? 'แผนภาพโครงสร้าง 3 เสาหลัก CIA Triad' : 'Architectural diagram of CIA Triad Pillars');
  triadImg.setAttribute('aria-hidden', 'true');
  diagramBar.append(triadImg);
  deck.append(diagramBar);

  // 3-Pillar Architectural Cards Grid
  const grid = element(doc, 'div', 'pillars-grid');
  const pillarsData = visual.pillars || [
    {
      key: 'confidentiality', tone: 'blue', symbol: 'C',
      term: { en: 'Confidentiality', th: 'การรักษาความลับ' },
      question: { en: 'Who can see the sensitive data?', th: 'ใครมีสิทธิ์มองเห็นข้อมูลลับบ้าง?' },
      summary: { en: 'Prevent unauthorized disclosure through encryption, ACLs, and MFA.', th: 'ป้องกันการเปิดเผยข้อมูลโดยมิชอบ ด้วยการเข้ารหัส ACLs และ MFA' }
    },
    {
      key: 'integrity', tone: 'green', symbol: 'I',
      term: { en: 'Integrity', th: 'ความถูกต้องครบถ้วน' },
      question: { en: 'Can we trust and rely on the data?', th: 'ข้อมูลถูกต้องแม่นยำและเชื่อถือได้หรือไม่?' },
      summary: { en: 'Protect data from unauthorized modification, tampering, or deletion.', th: 'ป้องกันการแก้ไข ดัดแปลง หรือทำลายข้อมูล ด้วยแฮชและลายมือชื่อดิจิทัล' }
    },
    {
      key: 'availability', tone: 'amber', symbol: 'A',
      term: { en: 'Availability', th: 'ความพร้อมใช้งาน' },
      question: { en: 'Can authorized users reach systems?', th: 'ผู้มีสิทธิ์เข้าถึงระบบได้เมื่อจำเป็นหรือไม่?' },
      summary: { en: 'Ensure timely, dependable access via redundancy, backups, and DR plans.', th: 'รับรองการเข้าถึงอย่างต่อเนื่อง ด้วยระบบสำรอง แบ็กอัป และแผนกู้คืน' }
    }
  ];

  for (const pillar of pillarsData) {
    const card = element(doc, 'article', `pillar-card tone-${pillar.tone || 'blue'}`);

    const cardHead = element(doc, 'div', 'pillar-card-header');
    const badge = element(doc, 'span', 'pillar-symbol-badge', pillar.symbol || '');
    const titleGroup = element(doc, 'div', 'pillar-title-group');
    const termObj = {
      en: pillar.term.en,
      th: `${pillar.term.en} (${pillar.term.th})`
    };
    const term = localize(element(doc, 'h4', 'pillar-term-title'), termObj, language);
    titleGroup.append(term);
    cardHead.append(badge, titleGroup);

    const questionBox = element(doc, 'div', 'pillar-question-box');
    const questionText = localize(element(doc, 'p', 'pillar-question-text'), pillar.question, language);
    questionBox.append(questionText);

    const summaryBox = element(doc, 'div', 'pillar-summary-box');
    const summaryText = localize(element(doc, 'p', 'pillar-summary-text'), pillar.summary, language);
    summaryBox.append(summaryText);

    card.append(cardHead, questionBox, summaryBox);
    grid.append(card);
  }
  deck.append(grid);

  // Bottom Takeaway Bar
  const takeawayTextObj = visual.takeaway || {
    en: 'Security controls work together: strong encryption cannot help if systems are down or records are tampered with.',
    th: 'มาตรการความปลอดภัยต้องทำงานร่วมกัน การเข้ารหัสที่ดีจะไร้ผลหากระบบล่ม หรือข้อมูลถูกแก้ไขทำลาย'
  };
  const takeawayBar = element(doc, 'aside', 'pillars-takeaway-bar');
  const icon = element(doc, 'span', 'pillars-takeaway-icon', '✦');
  const takeawayText = localize(element(doc, 'p', 'pillars-takeaway-text'), takeawayTextObj, language);
  takeawayBar.append(icon, takeawayText);
  deck.append(takeawayBar);

  host.append(deck);
  return { destroy() {} };
}

/** Slide 3: Confidentiality Deep Dive */
export function renderConfidentiality(host, { slide, language }) {
  const doc = host.ownerDocument;
  const isThai = language === 'th';

  const deck = element(doc, 'div', 'cia-presentation cia-concept-presentation cia-confidentiality-slide');
  deck.setAttribute('lang', isThai ? 'th' : 'en');

  // Header
  const header = element(doc, 'header', 'cia-pres-header');
  const eyebrow = element(doc, 'span', 'cia-pres-eyebrow', isThai ? 'เสาหลักที่ 1 · CONFIDENTIALITY' : 'PILLAR 1 · CONFIDENTIALITY');
  const headline = element(doc, 'h3', 'cia-pres-title', isThai
    ? 'Confidentiality: การป้องกันการเปิดเผยข้อมูลโดยไม่ได้รับอนุญาต'
    : 'Confidentiality: Protecting Against Unauthorized Disclosure');
  header.append(eyebrow, headline);
  deck.append(header);

  // Two-column split layout
  const split = element(doc, 'div', 'cia-split-grid');

  // Left Column: Core Principle & 3 Defense Layers
  const leftCol = element(doc, 'div', 'cia-split-col');

  // Definition Box
  const defBox = element(doc, 'div', 'cia-callout-card tone-blue');
  const defBadge = element(doc, 'span', 'cia-card-kicker', isThai ? 'คำจำกัดความหลัก' : 'CORE DEFINITION');
  const defText = element(doc, 'p', 'cia-card-text', isThai
    ? 'การรับรองว่าข้อมูลสำคัญจะถูกเข้าถึงได้ เฉพาะผู้ที่ได้รับอนุญาตเท่านั้น'
    : 'Ensuring sensitive information is accessible ONLY to authorized individuals, entities, or processes.');
  const goldenRule = element(doc, 'div', 'cia-golden-rule', isThai
    ? '⚠️ กฎสำคัญในข้อสอบ: การละเมิดเกิดขึ้นทันทีที่มีการเปิดดูโดยไม่ได้รับอนุญาต แม้ข้อมูลจะไม่ถูกดัดแปลงแม้แต่ไบต์เดียว!'
    : '⚠️ Critical Exam Rule: A breach occurs whenever unauthorized viewing takes place — even if 0 bytes are altered or deleted!');
  defBox.append(defBadge, defText, goldenRule);
  leftCol.append(defBox);

  // 3 Defense Layers List
  const layersList = element(doc, 'div', 'cia-layers-list');
  const layers = [
    {
      num: '1', title: { en: 'Cryptographic Encryption', th: 'การเข้ารหัสข้อมูล' },
      detail: { en: 'AES-256 for data at rest; TLS 1.3 for data in transit across networks.', th: 'AES-256 สำหรับข้อมูลที่จัดเก็บ และ TLS 1.3 สำหรับข้อมูลส่งผ่านเครือข่าย' }
    },
    {
      num: '2', title: { en: 'Granular Access Controls', th: 'การควบคุมสิทธิ์อย่างละเอียด' },
      detail: { en: 'Enforce Principle of Least Privilege and Role-Based Access Control (RBAC).', th: 'บังคับใช้สิทธิ์เท่าที่จำเป็น (Least Privilege) และตามบทบาท (RBAC)' }
    },
    {
      num: '3', title: { en: 'Administrative Governance', th: 'นโยบายการบริหาร' },
      detail: { en: 'Data classification schemes, clean desk policies, and Non-Disclosure Agreements (NDAs).', th: 'การจัดชั้นความลับ นโยบายจัดโต๊ะทำงาน และสัญญา NDA' }
    }
  ];

  for (const l of layers) {
    const item = element(doc, 'div', 'cia-layer-item');
    const badge = element(doc, 'span', 'cia-layer-badge', l.num);
    const textGroup = element(doc, 'div', 'cia-layer-text');
    const title = element(doc, 'strong', 'cia-layer-title', l.title[isThai ? 'th' : 'en']);
    const detail = element(doc, 'span', 'cia-layer-desc', l.detail[isThai ? 'th' : 'en']);
    textGroup.append(title, detail);
    item.append(badge, textGroup);
    layersList.append(item);
  }
  leftCol.append(layersList);
  split.append(leftCol);

  // Right Column: Vector Artwork & Scenario Diagnostic
  const rightCol = element(doc, 'div', 'cia-split-col');

  // Vector Artwork
  const artCard = element(doc, 'div', 'cia-visual-card');
  const artImg = element(doc, 'img', 'cia-vector-art');
  artImg.setAttribute('src', new URL('../../../assets/learning/cia-confidentiality-layers.svg', import.meta.url).href);
  artImg.setAttribute('alt', 'Confidentiality defense layers');
  artImg.setAttribute('aria-hidden', 'true');
  artCard.append(artImg);
  rightCol.append(artCard);

  // Scenario Case Box
  const scenarioCard = element(doc, 'div', 'cia-scenario-card');
  const scHead = element(doc, 'div', 'cia-scenario-header');
  const scBadge = element(doc, 'span', 'cia-scenario-tag', isThai ? 'สถานการณ์ตัวอย่าง' : 'ENTERPRISE SCENARIO');
  const scTitle = element(doc, 'h4', 'cia-scenario-title', isThai ? 'กรณีเปิดอ่านไฟล์เงินเดือนผู้บริหาร' : 'Executive Salary Spreadsheet Incident');
  scHead.append(scBadge, scTitle);

  const scText = element(doc, 'p', 'cia-scenario-narrative', isThai
    ? 'พนักงานฝึกงานเปิดอ่านไฟล์เงินเดือนของผู้บริหารในเครือข่ายที่ไม่ได้เข้ารหัส แม้ไม่มีการแก้ตัวเลขใด ๆ เลย แต่ Confidentiality ถูกละเมิดทันทีเพราะผู้ไม่มีสิทธิ์ได้มองเห็นข้อมูลลับ'
    : 'An unauthorized intern opens an unencrypted network spreadsheet containing executive compensation and views everyone\'s salaries. Because restricted data was viewed by someone without need-to-know, Confidentiality was violated—even though no payroll numbers were modified.');

  const scVerdict = element(doc, 'div', 'cia-diagnostic-verdict tone-blue');
  scVerdict.innerHTML = isThai
    ? '<strong>ผลวินิจฉัยข้อสอบ:</strong> การแอบดูข้อมูลลับโดยไม่มีสิทธิ์ถือเป็นการละเมิดความลับโดยสมบูรณ์ ไม่จำเป็นต้องมีการแก้ไขตัวเลขใด ๆ'
    : '<strong>Exam Diagnostic:</strong> Viewing restricted data without authorization is a full breach. Unauthorized modification is NOT required to violate Confidentiality.';

  scenarioCard.append(scHead, scText, scVerdict);
  rightCol.append(scenarioCard);

  split.append(rightCol);
  deck.append(split);

  host.append(deck);
  return { destroy() {} };
}

/** Slide 4: Integrity Deep Dive */
export function renderIntegrity(host, { slide, language }) {
  const doc = host.ownerDocument;
  const isThai = language === 'th';

  const deck = element(doc, 'div', 'cia-presentation cia-concept-presentation cia-integrity-slide');
  deck.setAttribute('lang', isThai ? 'th' : 'en');

  // Header
  const header = element(doc, 'header', 'cia-pres-header');
  const eyebrow = element(doc, 'span', 'cia-pres-eyebrow', isThai ? 'เสาหลักที่ 2 · INTEGRITY' : 'PILLAR 2 · INTEGRITY');
  const headline = element(doc, 'h3', 'cia-pres-title', isThai
    ? 'Integrity: การป้องกันการแก้ไขดัดแปลงข้อมูลโดยไม่ได้รับอนุญาต'
    : 'Integrity: Protecting Against Unauthorized Modification');
  header.append(eyebrow, headline);
  deck.append(header);

  // Two-column split layout
  const split = element(doc, 'div', 'cia-split-grid');

  // Left Column: Definition, SQ-13 Distinction, and Safeguards
  const leftCol = element(doc, 'div', 'cia-split-col');

  const defBox = element(doc, 'div', 'cia-callout-card tone-green');
  const defBadge = element(doc, 'span', 'cia-card-kicker', isThai ? 'คำจำกัดความหลัก' : 'CORE DEFINITION');
  const defText = element(doc, 'p', 'cia-card-text', isThai
    ? 'การรับรองว่าข้อมูลและระบบมีความถูกต้อง ครบถ้วน สมบูรณ์ และปลอดภัยจากการถูกแก้ไข ดัดแปลง แทรกแซง หรือลบทำลายโดยไม่ได้รับอนุญาตตลอดวงจรชีวิต'
    : 'Ensuring that information and systems remain accurate, complete, and protected against unauthorized modification, insertion, or deletion throughout their entire lifecycle.');

  const sq13Box = element(doc, 'div', 'cia-golden-rule tone-green', isThai
    ? '🎯 จุดเน้นข้อสอบ (SQ-13): การดัดแปลงหรือแก้ไขข้อมูลเป็นความเสียหายต่อ Integrity โดยตรง แม้ผู้โจมตีจะมองเห็นข้อมูลก่อน แต่การเปลี่ยนแปลงค่าทำลายความถูกต้องน่าเชื่อถือของข้อมูล'
    : '🎯 Exam Distinction (SQ-13): Altering or tampering with data is STRICTLY an Integrity violation. While an attacker might view data beforehand, changing values directly destroys data trustworthiness.');
  defBox.append(defBadge, defText, sq13Box);
  leftCol.append(defBox);

  // 3 Verification Mechanisms
  const layersList = element(doc, 'div', 'cia-layers-list');
  const safeguards = [
    {
      num: '1', title: { en: 'Cryptographic Hashes (SHA-256)', th: 'การแฮชทางรหัสลับ (SHA-256)' },
      detail: { en: 'Generate unique mathematical checksums to verify that data has not changed in transit or storage.', th: 'สร้างค่าตรวจสอบเฉพาะเพื่อพิสูจน์ว่าข้อมูลไม่มีการเปลี่ยนแปลงระหว่างส่งหรือจัดเก็บ' }
    },
    {
      num: '2', title: { en: 'Digital Signatures (Non-Repudiation)', th: 'ลายมือชื่อดิจิทัล (Non-Repudiation)' },
      detail: { en: 'Combine asymmetric cryptography and hashing to provide authentication, integrity, and non-repudiation.', th: 'รวมกุญแจอสมมาตรและการแฮช เพื่อยืนยันตัวตน ตรวจสอบความถูกต้อง และไม่สามารถปฏิเสธความรับผิดชอบ' }
    },
    {
      num: '3', title: { en: 'File Integrity Monitoring (FIM)', th: 'ระบบตรวจสอบความสมบูรณ์ของไฟล์ (FIM)' },
      detail: { en: 'Continuously track critical operating system files and alert administrators to unauthorized changes.', th: 'ตรวจติดตามไฟล์ระบบสำคัญและแจ้งเตือนเมื่อมีการเปลี่ยนแปลงที่ไม่ได้รับอนุญาต' }
    }
  ];

  for (const s of safeguards) {
    const item = element(doc, 'div', 'cia-layer-item tone-green');
    const badge = element(doc, 'span', 'cia-layer-badge', s.num);
    const textGroup = element(doc, 'div', 'cia-layer-text');
    const title = element(doc, 'strong', 'cia-layer-title', s.title[isThai ? 'th' : 'en']);
    const detail = element(doc, 'span', 'cia-layer-desc', s.detail[isThai ? 'th' : 'en']);
    textGroup.append(title, detail);
    item.append(badge, textGroup);
    layersList.append(item);
  }
  leftCol.append(layersList);
  split.append(leftCol);

  // Right Column: Hash Vector Art & Wire Transfer Scenario
  const rightCol = element(doc, 'div', 'cia-split-col');

  const artCard = element(doc, 'div', 'cia-visual-card');
  const artImg = element(doc, 'img', 'cia-vector-art');
  artImg.setAttribute('src', new URL('../../../assets/learning/cia-integrity-hash.svg', import.meta.url).href);
  artImg.setAttribute('alt', 'Integrity hash checksum comparison');
  artImg.setAttribute('aria-hidden', 'true');
  artCard.append(artImg);
  rightCol.append(artCard);

  // Scenario Case Box
  const scenarioCard = element(doc, 'div', 'cia-scenario-card');
  const scHead = element(doc, 'div', 'cia-scenario-header');
  const scBadge = element(doc, 'span', 'cia-scenario-tag tone-green', isThai ? 'สถานการณ์ตัวอย่าง' : 'ENTERPRISE SCENARIO');
  const scTitle = element(doc, 'h4', 'cia-scenario-title', isThai ? 'กรณีดัดแปลงคำสั่งโอนเงินทางอิเล็กทรอนิกส์' : 'Electronic Wire Transfer Tampering Incident');
  scHead.append(scBadge, scTitle);

  const scText = element(doc, 'p', 'cia-scenario-narrative', isThai
    ? 'ผู้โจมตีดักจับคำสั่งโอนเงินแล้วแก้ไขหมายเลขบัญชีธนาคารปลายทาง ธนาคารประมวลผลคำสั่งตามเวลาปกติ (ระบบไม่ล่ม) แต่เงินถูกโอนเข้าบัญชีคนร้าย ความถูกต้องของข้อมูลถูกทำลายลงอย่างสิ้นเชิง ซึ่งเป็นความเสียหายต่อ Integrity โดยตรง'
    : 'An attacker intercepts an electronic wire transfer instruction and alters the beneficiary bank routing number. The bank executes payment on schedule, but funds transfer into the criminal\'s account. Accuracy and trust in transaction data failed completely — a direct Integrity compromise.');

  const scVerdict = element(doc, 'div', 'cia-diagnostic-verdict tone-green');
  scVerdict.innerHTML = isThai
    ? '<strong>กับดักข้อสอบที่ต้องระวัง:</strong> อย่าสับสนระหว่างการเปิดเผยกับการดัดแปลง เมื่อใดก็ตามที่ข้อมูลถูกเปลี่ยนค่า เสาหลักที่ถูกละเมิดคือ Integrity เสมอ!'
    : '<strong>Common Exam Trap:</strong> Do not confuse alteration with disclosure. Altering data is strictly an Integrity violation (SQ-13), even if an attacker viewed it first.';

  scenarioCard.append(scHead, scText, scVerdict);
  rightCol.append(scenarioCard);

  split.append(rightCol);
  deck.append(split);

  host.append(deck);
  return { destroy() {} };
}

