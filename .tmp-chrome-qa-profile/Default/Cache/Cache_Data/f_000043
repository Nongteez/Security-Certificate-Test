    // Col 1: Goal
    const tdGoal = element(doc, 'td', 'matrix-cell-goal');
    const badge = element(doc, 'span', 'matrix-pillar-badge', r.symbol);
    const goalText = element(doc, 'strong', 'matrix-goal-name', r.goal[isThai ? 'th' : 'en']);
    tdGoal.append(badge, goalText);

    // Col 2: Keywords
    const tdKey = element(doc, 'td', 'matrix-cell-keywords');
    const kwWrap = element(doc, 'div', 'matrix-kw-chips');
    const kwList = isThai ? r.keywords.th : r.keywords.en;
    for (const kw of kwList) {
      kwWrap.append(element(doc, 'span', 'matrix-kw-chip', kw));
    }
    tdKey.append(kwWrap);

    // Col 3: Safeguards
    const tdSafe = element(doc, 'td', 'matrix-cell-safeguards', r.safeguards[isThai ? 'th' : 'en']);

    // Col 4: Trap
    const tdTrap = element(doc, 'td', 'matrix-cell-trap');
    const trapText = element(doc, 'span', 'matrix-trap-alert', r.trap[isThai ? 'th' : 'en']);
    tdTrap.append(trapText);

    tr.append(tdGoal, tdKey, tdSafe, tdTrap);
    tbody.append(tr);
  }
  table.append(tbody);
  matrixWrap.append(table);
  deck.append(matrixWrap);

  // References Footer Strip
  const footer = element(doc, 'footer', 'cia-matrix-footer');
  const scopeTag = element(doc, 'span', 'matrix-footer-tag', isThai
    ? 'ขอบเขตทางการ: ISC2 Certified in Cybersecurity (CC) 2026 · โดเมน 1 (1.1)'
    : 'Official Scope: ISC2 Certified in Cybersecurity (CC) 2026 · Domain 1 (1.1)');
  const refTag = element(doc, 'span', 'matrix-footer-refs', 'NIST FIPS PUB 199 (Sec. 3) · NIST SP 800-61 Rev. 2 (Sec. 2)');
  footer.append(scopeTag, refTag);
  deck.append(footer);

  host.append(deck);
  return { destroy() {} };
}
