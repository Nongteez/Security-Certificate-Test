.reading-body .reading-semantic-diagram .reading-semantic-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  gap: 16px;
  margin: 16px 0;
}
.reading-body .reading-semantic-diagram .reading-semantic-concept {
  min-width: 0;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--panel);
}
.reading-body .reading-semantic-diagram [data-optional="true"] {
  border-style: dashed;
}
.reading-body .reading-semantic-diagram h5,
.reading-body .reading-semantic-diagram h6 {
  margin: 0 0 12px;
  font-size: 16px;
  line-height: 1.55;
  color: var(--text);
}
.reading-body .reading-semantic-diagram p,
.reading-body .reading-semantic-diagram li {
  font-size: 15.5px;
  line-height: 1.7;
  word-break: normal;
  overflow-wrap: normal;
}
.reading-body .reading-semantic-diagram p {
  margin: 8px 0;
}
.reading-body .reading-semantic-diagram ul {
  margin: 8px 0;
  padding-left: 22px;
}
.reading-body .reading-semantic-diagram .reading-semantic-group,
.reading-body .reading-semantic-diagram .reading-semantic-governance {
  margin: 24px 0 0;
}
.reading-body .reading-diagram-card > .reading-semantic-note {
  margin: 16px 0;
  padding: 12px;
  border-left: 2px solid var(--line);
  font-size: 15.5px;
  line-height: 1.7;
  word-break: normal;
  overflow-wrap: normal;
}
/* End Phase 3D semantic representations. */

/* Phase 3C: content-driven Reading tables and intact technical words. */
.reading-body .reading-table-wrapper {
  max-width: 100%;
  scrollbar-width: auto;
  scrollbar-color: var(--text-muted) var(--panel-2);
}
.reading-body .reading-table-wrapper:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}
.reading-body .reading-table {
  table-layout: auto;
  min-width: min-content;
}
.reading-body .reading-table th,
.reading-body .reading-table td {
  word-break: normal;
  overflow-wrap: normal;
  hyphens: manual;
}
/* A readable floor for comparisons, without prescribing column proportions.
   Two-column tables retain their natural sizing; existing document roles win. */
.reading-body .reading-table:has(th:nth-child(3)) th {
  min-width: 9rem;
}
.reading-body .reading-table .reading-term-en,
.reading-body .reading-table .reading-term-en strong {
  white-space: normal;
}
/* GRC's fixed percentages plus a nowrap keyword exceeded padded cell bounds.
   Let each column participate in native min-content sizing, as other tables do. */
.reading-body .reading-table-grc-frameworks th:nth-child(n),
.reading-body .reading-table-grc-frameworks td:nth-child(n) {
  width: auto;
  min-width: 9rem;
}
.reading-body .reading-table-grc-frameworks td.reading-col-exam-keyword strong {
  white-space: normal;
}
/* Risk-card badges must yield space rather than fragment the English title. */
.reading-body .reading-treatment-header {
  flex-wrap: wrap;
}
.reading-body .reading-treatment-title-group {
  flex: 1 1 16rem;
  min-width: 0;
}
.reading-body .reading-treatment-title {
  word-break: normal;
  overflow-wrap: normal;
}
.reading-body .reading-scenario-header {
  flex-wrap: wrap;
}
.reading-body .reading-scenario-badge {
  flex-shrink: 0;
  word-break: normal;
  overflow-wrap: normal;
}
.reading-body .reading-scenario-topic {
  word-break: normal;
  overflow-wrap: normal;
}
/* End Phase 3C scoped tables. */

/* Phase 3B.3: content-aware widths within published Reading Notes only. */
.app:has(.reading-structured-objective) {
  max-width: 1560px;
}
.reading-screen:has(.reading-structured-objective) .reading-layout {
  gap: 32px;
}
.reading-screen:has(.reading-structured-objective) .reading-article {
  max-width: 100%;
}
.reading-body .reading-structured-objective {
  --reading-narrative-measure: 96ch;
  --reading-definition-measure: 104ch;
}
.reading-body .reading-structured-objective > p:not(.reading-intro-label),
.reading-body .reading-privacy-context > p {
  max-width: min(100%, var(--reading-narrative-measure));
  font-size: 16px;
  line-height: 1.85;
}
.reading-body .reading-structured-objective .reading-concept-unit {
  max-width: 100%;
}
.reading-body .reading-structured-objective .reading-concept-unit > p,
.reading-body .reading-structured-objective .reading-concept-item > p {
  max-width: min(100%, var(--reading-definition-measure));
  font-size: 16px;
  line-height: 1.85;
}
.reading-body .reading-structured-objective > ul,
.reading-body .reading-structured-objective > ol,
.reading-body .reading-structured-objective .reading-concept-unit > ul,
.reading-body .reading-structured-objective .reading-concept-unit > ol {
  max-width: 100%;
}
.reading-body .reading-structured-objective :is(h4, h5).reading-intro-label {
  font-weight: 600;
  align-items: flex-start;
}
.reading-body .reading-structured-objective .reading-intro-label .reading-label-icon {
  width: 14px;
  height: 14px;
  margin-top: 5px;
}
.reading-body .reading-privacy-context {
  container: privacy-context / inline-size;
}
.reading-body .reading-privacy-context > h4 {
  margin: 32px 0 12px;
  font-size: 17px;
  line-height: 1.55;
  font-weight: 700;
}
.reading-body .reading-privacy-context > h5.reading-intro-label {
  font-size: 16px;
  line-height: 1.55;
}
.reading-body .reading-privacy-roles {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 24px;
  margin: 16px 0 32px;
}
.reading-body .reading-privacy-roles > .reading-concept-item {
  min-width: 0;
  margin: 0;
  padding-left: 0;
  border-left: 0;
}
.reading-body .reading-privacy-roles .reading-concept-heading {
  font-size: 16px;
  line-height: 1.55;
  margin-bottom: 8px;
}
.reading-body .reading-privacy-roles .reading-concept-item > p {
  max-width: 100%;
}
@container privacy-context (min-width: 56rem) {
  .reading-body .reading-privacy-roles {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
@media (min-width: 841px) {
  .app:has(.reading-structured-objective) {
    width: min(100% - 48px, 1560px);
  }
  .reading-screen:has(.reading-structured-objective) .reading-sidebar {
    flex-basis: 270px;
    width: 270px;
  }
}
@media (min-width: 841px) and (max-width: 1100px) {
  .reading-screen:has(.reading-structured-objective) .reading-layout {
    gap: 28px;
  }
}
/* End Phase 3B.3 content-aware widths. */

/* Phase 3B.1: semantic hierarchy for the two Domain 4 pilot subsections. */
.reading-body .reading-structure-pilot {
    display: flow-root;
    margin: 40px 0;
}
.reading-body .reading-structure-pilot > h3 {
    margin: 0 0 16px;
    font-size: 19px;
    line-height: 1.5;
}
.reading-body .reading-structure-pilot > .reading-concept-group-title {
    margin: 32px 0 12px;
    font-size: 17px;
    line-height: 1.55;
}
.reading-body .reading-structure-pilot .reading-definition-unit {
    display: flow-root;
    margin: 0 0 24px;
}
.reading-body .reading-structure-pilot .reading-definition-unit > h5 {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.55;
    font-weight: 700;
    color: var(--text);
}
.reading-body .reading-structure-pilot .reading-layer-unit {
    display: flow-root;
    margin: 32px 0 0;
}
.reading-body .reading-structure-pilot .reading-layer-unit > h4 {
    margin: 0 0 8px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--text);
}
.reading-body .reading-structure-pilot p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.8;
}
.reading-body .reading-structure-pilot ul,
.reading-body .reading-structure-pilot ol {
    margin: 0 0 16px;
    padding-left: 24px;
}
.reading-body .reading-structure-pilot li {
    margin-bottom: 8px;
    font-size: 16px;
    line-height: 1.8;
}
.reading-body .reading-structure-pilot li:last-child,
.reading-body .reading-structure-pilot .reading-definition-unit > :last-child,
.reading-body .reading-structure-pilot .reading-layer-unit > :last-child {
    margin-bottom: 0;
}
.reading-body .reading-structure-pilot li > ul,
.reading-body .reading-structure-pilot li > ol {
    margin: 6px 0;
}
.reading-body .reading-structure-pilot .reading-example-box {
    margin: 16px 0;
}
.reading-body .reading-structure-pilot .reading-callout.tip,
.reading-body .reading-structure-pilot .reading-exam-trap {
    margin: 24px 0;
}
