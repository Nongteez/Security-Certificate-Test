}

.reading-bilingual-term .reading-term-th {
  font-weight: 600;
  color: var(--text-dim);
  font-size: 0.88rem;
  line-height: 1.35;
}

/* Document Hierarchy Table (Section 1.3.4) Balanced Column Widths */
.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table th:nth-child(1),
.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table td:nth-child(1) {
  width: 18%;
  min-width: 145px;
}

.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table th:nth-child(2),
.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table td:nth-child(2) {
  width: 35%;
  min-width: 220px;
}

.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table th:nth-child(3),
.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table td:nth-child(3) {
  width: 17%;
  min-width: 140px;
}

.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table th:nth-child(4),
.reading-diagram-card[data-diagram="documentHierarchy"] + .reading-table-wrapper .reading-table td:nth-child(4) {
  width: 30%;
  min-width: 200px;
}

/* ===== GRC Frameworks and Standards Comparison Table (Section 2.1.4) ===== */
.reading-table-grc-frameworks-wrapper {
  position: relative;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: var(--line) transparent;
}

.reading-table-grc-frameworks-wrapper::-webkit-scrollbar {
  height: 6px;
}

.reading-table-grc-frameworks-wrapper::-webkit-scrollbar-track {
  background: transparent;
}

.reading-table-grc-frameworks-wrapper::-webkit-scrollbar-thumb {
  background: var(--line);
  border-radius: 3px;
}

.reading-table-grc-frameworks {
  width: 100%;
  min-width: 780px;
  table-layout: fixed;
}

/* Col 1: Framework / Standard */
.reading-table-grc-frameworks th:nth-child(1),
.reading-table-grc-frameworks td:nth-child(1) {
  width: 20%;
  min-width: 160px;
}

/* Col 2: จุดเน้นหลัก (Primary Focus) */
.reading-table-grc-frameworks th:nth-child(2),
.reading-table-grc-frameworks td:nth-child(2) {
  width: 24%;
  min-width: 180px;
}

/* Col 3: ขอบเขตและการนำไปใช้ */
.reading-table-grc-frameworks th:nth-child(3),
.reading-table-grc-frameworks td:nth-child(3) {
  width: 32%;
  min-width: 240px;
}

/* Col 4: คำจำสั้นสำหรับสอบ */
.reading-table-grc-frameworks th:nth-child(4),
.reading-table-grc-frameworks td:nth-child(4),
.reading-table-grc-frameworks th.reading-col-exam-keyword,
.reading-table-grc-frameworks td.reading-col-exam-keyword {
  width: 24%;
  min-width: 200px;
  word-break: normal !important;
  overflow-wrap: normal !important;
}

.reading-table-grc-frameworks td:nth-child(4) strong,
.reading-table-grc-frameworks td.reading-col-exam-keyword strong {
  display: inline-block;
  color: var(--blue);
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.4;
  word-break: normal !important;
  overflow-wrap: normal !important;
  white-space: nowrap;
}

/* High contrast theme support */
[data-theme="light"] .reading-table-grc-frameworks td:nth-child(4) strong,
[data-theme="light"] .reading-table-grc-frameworks td.reading-col-exam-keyword strong,
.light-theme .reading-table-grc-frameworks td:nth-child(4) strong,
.light-theme .reading-table-grc-frameworks td.reading-col-exam-keyword strong {
  color: #1d4ed8;
}

.reading-table-note {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: calc(var(--space-sm) * -1 + 4px);
  margin-bottom: var(--space-lg);
  line-height: 1.5;
  font-style: italic;
}

.reading-table-wrapper + .reading-table-note {
  margin-top: calc(var(--space-md) * -1 + 4px);
}

/* ===== Responsive Breakpoints ===== */
@media (max-width: 840px) {
  .reading-screen {
    padding: 12px 16px 40px;
  }

  .reading-top-bar {
    margin-bottom: 20px;
  }

  .reading-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 999;
    backdrop-filter: blur(2px);
  }

  .reading-layout.mobile-sidebar-open .reading-backdrop {
    display: block;
  }

  .reading-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 310px;
    height: 100vh;
    max-height: 100vh;
    z-index: 1000;
    background: var(--panel);
    border-radius: 0;
    border-left: none;
    border-top: none;
    border-bottom: none;
    border-right: 1px solid var(--line);
    padding: 20px;
    transform: translateX(-100%);
    visibility: hidden;
    pointer-events: none;
    box-shadow: var(--shadow);
  }

  /* Desktop collapse must not disable the independently controlled mobile drawer. */
  .reading-layout.sidebar-collapsed .reading-sidebar {
    display: block;
  }

  .reading-layout.mobile-sidebar-open .reading-sidebar {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
  }

  .reading-sidebar-close-mobile {
    display: inline-flex;
  }

  .reading-article-title {
    font-size: 26px;
  }
}

@media (max-width: 600px) {
  .reading-top-center {
    display: none;
  }

  .btn-toggle-label {
    display: none;
  }

  .btn-toggle-sidebar {
    padding: 6px 10px;
  }
}

