/* ==========================================================================
   ISC2 CC 2026 — Reading Notes CSS Styles
   Clean, minimal technical documentation layout with dark/light theme support
   ========================================================================== */

:root {
  --reading-screen-max-width: 1560px;
  --reading-article-max-width: 1080px;
  --reading-prose-max-width: 100%;
  --reading-component-max-width: 1040px;

  /* Vertical Rhythm Spacing Tokens (4px / 8px Base Grid) */
  --space-2xs: 4px;
  --space-xs: 8px;
  --space-sm: 12px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 44px;
  --space-3xl: 60px;

  /* Table Typography & Visual Hierarchy Tokens */
  --table-header-font-size: 0.94rem;
  --table-header-font-weight: 700;
  --table-body-font-size: 0.92rem;
  --table-body-line-height: 1.65;
  --table-cell-padding-y: 12px;
  --table-cell-padding-x: 16px;
  --table-row-hover-bg: rgba(99, 102, 241, 0.04);
}

/* ===== Outer Screen & Header ===== */
/* hidden creates a non-scrolling sticky ancestor; clip preserves viewport stickiness. */
body:has(.reading-screen) {
  overflow-x: clip;
}

.reading-screen {
  max-width: var(--reading-screen-max-width);
  margin: 0 auto;
  padding: 12px 24px 80px;
  min-height: 100vh;
}

.reading-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0 18px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 32px;
}

.reading-top-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-toggle-sidebar {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  padding: 7px 12px;
  font-size: 13px;
  font-weight: 500;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--panel);
  color: var(--text-dim);
  transition: all 0.15s ease;
}

.btn-toggle-sidebar:hover {
  background: var(--panel-2);
  color: var(--text);
  border-color: var(--line-hover);
}

.reading-top-center {
  display: flex;
  align-items: center;
}

.reading-app-badge {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--text-dim);
  background: var(--panel-2);
  border: 1px solid var(--line);
  padding: 4px 12px;
  border-radius: 20px;
}

/* ===== Layout Container ===== */
.reading-layout {
  display: flex;
  gap: 48px;
  position: relative;
  align-items: flex-start;
}

.reading-backdrop {
  display: none;
}

/* ===== Minimal Left Sidebar ===== */
.reading-sidebar {
  flex: 0 0 290px;
  width: 290px;
  position: sticky;
  top: 16px;
  max-height: calc(100vh - 80px);
  overflow-y: auto;
  background: transparent;
  border-right: 1px solid var(--line);
  padding: 0 16px 32px 0;
  box-shadow: none;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
              width 0.25s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.2s ease;
}

/* Custom scrollbar for sidebar */
.reading-sidebar::-webkit-scrollbar {
  width: 4px;
}
.reading-sidebar::-webkit-scrollbar-track {
  background: transparent;
}
.reading-sidebar::-webkit-scrollbar-thumb {
  background: var(--line);
  border-radius: 4px;
}

.reading-sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 10px;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--line);
}

.reading-sidebar-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-dim);
}

.reading-sidebar-close-mobile {
  display: none;
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
}
.reading-sidebar-close-mobile:hover {
  color: var(--text);
  background: var(--panel-2);
}

/* Collapsed sidebar on desktop */
.reading-layout.sidebar-collapsed .reading-sidebar {
  display: none;
}

.reading-layout.sidebar-collapsed .reading-content-pane {
  flex: 1 1 100%;
  max-width: 1240px;
  margin: 0 auto;
  width: 100%;
}

.reading-layout.sidebar-collapsed .reading-article {
  max-width: 1140px;
  width: 100%;
  margin: 0 auto;
}

.reading-layout.sidebar-collapsed .reading-lead,
.reading-layout.sidebar-collapsed .reading-article-markdown > p,
.reading-layout.sidebar-collapsed .reading-article-markdown > ul,
.reading-layout.sidebar-collapsed .reading-article-markdown > ol,
.reading-layout.sidebar-collapsed .reading-article-markdown > blockquote,
.reading-layout.sidebar-collapsed .reading-objective-section > p,
.reading-layout.sidebar-collapsed .reading-objective-section > ul,
.reading-layout.sidebar-collapsed .reading-objective-section > ol,
.reading-layout.sidebar-collapsed .reading-objective-section > blockquote,
.reading-layout.sidebar-collapsed .reading-intro-label {
  max-width: 100%;
}

.reading-layout.sidebar-collapsed .reading-concept-grid,
.reading-layout.sidebar-collapsed .reading-response-grid,
.reading-layout.sidebar-collapsed .reading-mfa-stack,
.reading-layout.sidebar-collapsed .reading-treatment-stack,
.reading-layout.sidebar-collapsed .reading-category-stack,
.reading-layout.sidebar-collapsed .reading-distinction-grid,
.reading-layout.sidebar-collapsed .reading-precedence-stack,
.reading-layout.sidebar-collapsed .reading-table-wrapper,
.reading-layout.sidebar-collapsed .reading-diagram-card,
.reading-layout.sidebar-collapsed .reading-formula-card,
.reading-layout.sidebar-collapsed .reading-scenario-card {
  max-width: 100%;
  width: 100%;
}

/* ===== Text-Based 3-Level Navigation ===== */
.reading-nav-domains {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.reading-nav-group {
  display: flex;
  flex-direction: column;
}

.reading-nav-domain-row {
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 2px 0;
}

.reading-chevron-btn {
  background: transparent;
  border: none;
  width: 22px;
  height: 22px;
  padding: 0;
  color: var(--text-dim);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  transition: color 0.15s ease, background-color 0.15s ease;
}

.reading-chevron-btn:hover {
  color: var(--text);
  background: var(--panel-hover);
}

.reading-chevron-svg {
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.reading-chevron-btn.expanded .reading-chevron-svg {
  transform: rotate(90deg);
}

.reading-domain-btn {
  flex: 1;
  text-align: left;
  background: transparent;
  border: none;
  padding: 6px 8px;
  cursor: pointer;
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-family: inherit;
  color: var(--text-dim);
  border-radius: var(--radius-sm);
  transition: color 0.15s ease, background-color 0.15s ease;
}

.reading-domain-btn:hover {
  color: var(--text);
  background: var(--panel-hover);
}

.reading-domain-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-muted);
}

.reading-domain-title {
  font-size: 13.5px;
  font-weight: 500;
  line-height: 1.35;
  color: inherit;
}

.reading-domain-btn.active {
  color: var(--blue);
  background: var(--blue-bg);
}

.reading-domain-btn.active .reading-domain-label {
  color: var(--blue);
}

.reading-domain-btn.active .reading-domain-title {
  font-weight: 600;
}

/* Level 2: Objectives */
.reading-nav-sub-tree {
  padding-left: 18px;
  margin: 2px 0 6px 0;
}

.reading-nav-objectives {
  list-style: none;
  margin: 0;
  padding: 0 0 0 8px;
  border-left: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.reading-nav-objective-item {
  display: flex;
  flex-direction: column;
}

.reading-nav-objective-row {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 2px 0;
}

.reading-obj-chevron-btn {
  background: transparent;
  border: none;
  width: 18px;
  height: 18px;
  padding: 0;
  color: var(--text-dim);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 3px;
  transition: color 0.15s ease;
}

.reading-obj-chevron-btn:hover {
  color: var(--text);
}

.reading-obj-chevron-btn.expanded .reading-chevron-svg {
  transform: rotate(90deg);
}

.reading-obj-bullet {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--line);
  margin: 0 7px;
  flex-shrink: 0;
}

.reading-nav-objective-link {
  flex: 1;
  text-decoration: none;
  color: var(--text-muted);
  font-size: 12.5px;
  line-height: 1.4;
  padding: 2px 4px;
  border-radius: 3px;
  transition: color 0.15s ease, background 0.15s ease;
}

.reading-nav-objective-link:hover {
  color: var(--text);
  background: var(--panel-hover);
}

.reading-nav-objective-link.active {
  color: var(--blue);
  font-weight: 600;
}

.reading-nav-objective-static {
  display: block;
  font-size: 12.5px;
  line-height: 1.4;
  color: var(--text-muted);
  user-select: none;
  padding: 2px 4px;
}

/* Level 3: Topics */
.reading-nav-topics {
  list-style: none;
  margin: 2px 0 6px 14px;
  padding: 0 0 0 8px;
  border-left: 1px dashed var(--line);
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.reading-nav [hidden],
.reading-nav-topics[hidden],
.reading-nav-sub-tree[hidden] {
  display: none !important;
}

.reading-nav-topic-item {
  padding: 1px 0;
}

.reading-nav-topic-link {
  display: block;
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--text-dim);
  text-decoration: none;
  padding: 3px 6px;
  border-radius: 4px;
  transition: all 0.15s ease;
}

.reading-nav-topic-link:hover {
  color: var(--blue);
  background: var(--blue-bg);
}

.reading-nav-topic-link.active {
  color: var(--blue);
  font-weight: 600;
  background: var(--blue-bg);
}

/* ===== Main Reading Area (Direct on Page Background) ===== */
.reading-content-pane {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 0 80px;
}

.reading-article {
  width: 100%;
  max-width: var(--reading-article-max-width);
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
}

/* Measure constraint for ordinary prose to maintain optimal reading line-length */
.reading-lead,
.reading-article-markdown > p,
.reading-article-markdown > ul,
.reading-article-markdown > ol,
.reading-article-markdown > blockquote,
.reading-objective-section > p,
.reading-objective-section > ul,
.reading-objective-section > ol,
.reading-objective-section > blockquote,
.reading-intro-label {
  max-width: var(--reading-prose-max-width);
}

/* Wide educational content expands to use comfortable desktop space */
.reading-concept-grid,
.reading-response-grid,
.reading-mfa-stack,
.reading-treatment-stack,
.reading-category-stack,
.reading-distinction-grid,
.reading-precedence-stack,
.reading-table-wrapper,
.reading-diagram-card,
.reading-formula-card,
.reading-scenario-card {
  max-width: 100%;
  width: 100%;
}

.reading-article-header {
  margin-bottom: 32px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
}

.reading-eyebrow {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.reading-article-title {
  font-size: 32px;
  font-weight: 700;
  margin: 0;
  line-height: 1.25;
  letter-spacing: -0.015em;
  color: var(--text);
}

/* ===== Understated Unpublished Message ===== */
.reading-unpublished-note {
  padding: 24px 0;
}

.reading-unpublished-text {
  font-size: 15px;
  color: var(--text-muted);
  font-style: italic;
  margin: 0;
  line-height: 1.6;
}

/* ===== Prepared Editorial Typography for Markdown ===== */
.reading-article-markdown {
  font-family: 'Noto Sans Thai', 'Space Grotesk', system-ui, sans-serif;
  line-height: 1.8;
  color: var(--text);
  font-size: 15.5px;
  word-break: break-word;
}

.reading-objective-section {
  margin-top: var(--space-3xl);
  padding-top: var(--space-xl);
  border-top: 1px solid var(--line);
}

.reading-objective-section:first-of-type {
  margin-top: var(--space-xl);
}

.reading-objective-section > h2:first-child,
.reading-objective-section > h2:first-of-type {
  margin-top: 0;
}

.reading-topic-anchor {
  display: block;
  position: relative;
  top: -36px;
  visibility: hidden;
}

.reading-body h2 {
  font-size: 24px;
  font-weight: 700;
  margin: var(--space-2xl) 0 var(--space-md) 0;
  padding-bottom: 8px;
  color: var(--text);
  letter-spacing: -0.01em;
  scroll-margin-top: 40px;
}

.reading-body h3 {
  font-size: 19px;
  font-weight: 600;
  margin: var(--space-2xl) 0 var(--space-sm) 0;
  color: var(--text);
  letter-spacing: -0.005em;
  scroll-margin-top: 36px;
  break-after: avoid;
}

.reading-body h4,
.reading-subtopic-title {
  font-size: 16px;
  font-weight: 600;
  margin: var(--space-xl) 0 var(--space-xs) 0;
  color: var(--text);
  scroll-margin-top: 30px;
  break-after: avoid;
}

.reading-body p {
  font-size: 15.5px;
  line-height: 1.8;
  margin: 0 0 var(--space-md) 0;
  color: var(--text);
}

.reading-body .reading-lead,
.reading-lead {
  font-size: 16px;
  line-height: 1.8;
  color: var(--text);
  max-width: var(--reading-prose-max-width);
  margin-left: 0;
  margin-right: auto;
  margin-bottom: var(--space-xl);
}

/* ===== Semantic Introductory Labels & Leads ===== */
.reading-intro-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.005em;
  margin-top: var(--space-lg) !important;
  margin-bottom: var(--space-xs) !important;
  display: flex;
  align-items: center;
  gap: 8px;
  break-after: avoid;
}

.reading-intro-label .reading-label-icon {
  flex-shrink: 0;
  color: var(--blue);
}

/* Smart Sibling Proximity: Tightly connect intro labels and H4s to what they introduce */
.reading-intro-label + .reading-table-wrapper,
.reading-intro-label + .reading-concept-grid,
.reading-intro-label + .reading-response-grid,
.reading-intro-label + .reading-distinction-grid,
.reading-intro-label + .reading-precedence-rule,
.reading-intro-label + .reading-precedence-stack,
.reading-intro-label + .reading-diagram-card,
.reading-intro-label + .reading-formula-card,
.reading-intro-label + .reading-scenario-card,
.reading-intro-label + .reading-callout,
.reading-intro-label + .reading-example-box,
.reading-intro-label + .reading-calculation-box,
.reading-intro-label + ul,
.reading-intro-label + ol,
.reading-precedence-rule + .reading-precedence-stack,
h4 + .reading-table-wrapper,
h4 + .reading-concept-grid,
h4 + .reading-response-grid,
h4 + .reading-distinction-grid,
h4 + .reading-precedence-rule,
h4 + .reading-precedence-stack,
h4 + .reading-diagram-card,
h4 + .reading-formula-card,
h4 + .reading-scenario-card,
h4 + .reading-callout,
h4 + .reading-example-box,
h4 + .reading-calculation-box,
h4 + ul,
h4 + ol {
  margin-top: var(--space-xs) !important;
}

/* Proximity for introductory paragraphs immediately preceding lists */
.reading-body p + ul,
.reading-body p + ol {
  margin-top: calc(-1 * var(--space-xs));
}

.reading-body ul,
.reading-body ol {
  padding-left: 24px;
  margin: 0 0 var(--space-lg) 0;
  line-height: 1.75;
}

.reading-body li {
  margin-bottom: var(--space-xs);
  color: var(--text);
}

.reading-body li:last-child {
  margin-bottom: 0;
}

/* Nested lists: semantic indentation, refined spacing, and subtle subordinate bullets */
.reading-body li > ul,
.reading-body li > ol {
  margin: var(--space-xs, 0.5rem) 0 var(--space-xs, 0.5rem) 0;
  padding-left: 22px;
}

.reading-body li > ul {
  list-style-type: circle;
}

.reading-body li > ul > li {
  margin-bottom: var(--space-2xs, 0.25rem);
  font-size: 0.9375rem;
  line-height: 1.65;
  color: var(--text);
}

/* Proximity between content components and their following takeaways / callouts */
.reading-table-wrapper + blockquote,
.reading-concept-grid + blockquote,
.reading-response-grid + blockquote,
.reading-distinction-grid + blockquote,
.reading-precedence-stack + blockquote,
.reading-diagram-card + blockquote,
.reading-formula-card + blockquote,
.reading-table-wrapper + .reading-callout,
.reading-concept-grid + .reading-callout,
.reading-response-grid + .reading-callout,
.reading-distinction-grid + .reading-callout,
.reading-precedence-stack + .reading-callout,
.reading-diagram-card + .reading-callout,
.reading-formula-card + .reading-callout,
ul + blockquote,
ol + blockquote {
  margin-top: var(--space-md) !important;
}

/* Consecutive scenario cards proximity */
.reading-scenario-card + .reading-scenario-card {
  margin-top: var(--space-md) !important;
}

/* ===== Semantic Content Group Containers ===== */
.reading-content-group,
.reading-table-group {
  margin: var(--space-xl) 0;
  break-inside: avoid;
  page-break-inside: avoid;
}

.reading-content-group > :first-child,
.reading-table-group > :first-child {
  margin-top: 0 !important;
}

.reading-content-group > :last-child,
.reading-table-group > :last-child {
  margin-bottom: 0 !important;
}

/* Worked Calculation Walkthrough Box */
.reading-calculation-box {
  margin-top: var(--space-xs);
  margin-bottom: var(--space-lg);
  padding: 14px 18px;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  font-size: 14.5px;
  line-height: 1.7;
  color: var(--text);
}

.reading-calculation-title {
  font-weight: 600;
  color: var(--text);
  margin-bottom: var(--space-xs);
  display: flex;
  align-items: center;
  gap: 8px;
}

.reading-calculation-title svg {
  color: var(--blue);
}

.reading-calculation-box ul {
  padding-left: 20px;
  margin: 0;
}

.reading-calculation-box li {
  margin-bottom: 6px;
  color: var(--text);
}

.reading-calculation-box li:last-child {
  margin-bottom: 0;
}

/* Dedicated Concept Example Box */
.reading-example-box {
  margin: var(--space-sm) 0 var(--space-lg);
  padding: 12px 18px;
  background: var(--panel-2);
  border-left: 3px solid var(--blue);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 14.5px;
  line-height: 1.65;
  color: var(--text);
}

/* Standardized Exam Trap / Warning Callouts */
.reading-callout.warning,
.reading-exam-trap {
  margin: var(--space-md) 0 var(--space-lg);
  padding: 14px 18px;
  background: var(--amber-bg, rgba(245, 158, 11, 0.08));
  border: 1px solid var(--amber-border, rgba(245, 158, 11, 0.3));
  border-left: 4px solid #f59e0b;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 14.5px;
  line-height: 1.7;
}

.reading-callout.danger {
  margin: var(--space-md) 0 var(--space-lg);
  padding: 14px 18px;
  background: var(--rose-bg, rgba(239, 68, 68, 0.08));
  border: 1px solid var(--rose-border, rgba(239, 68, 68, 0.3));
  border-left: 4px solid #ef4444;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 14.5px;
  line-height: 1.7;
}

.reading-callout.tip,
.reading-callout.info {
  margin: var(--space-md) 0 var(--space-lg);
  padding: 14px 18px;
  background: var(--blue-bg, rgba(59, 130, 246, 0.07));
  border: 1px solid var(--blue-border, rgba(59, 130, 246, 0.25));
  border-left: 4px solid var(--blue, #3b82f6);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 14.5px;
  line-height: 1.7;
}

/* Callout Header with Single SVG Icon */
.reading-callout-header {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  font-weight: 700;
  font-size: 0.96rem;
  color: var(--text);
  margin-bottom: var(--space-sm);
}

.reading-callout-icon {
  flex-shrink: 0;
}

.reading-callout.warning .reading-callout-icon {
  color: #d97706;
}

.reading-callout.danger .reading-callout-icon {
  color: #dc2626;
}

.reading-callout.tip .reading-callout-icon,
.reading-callout.info .reading-callout-icon {
  color: var(--blue, #3b82f6);
}

/* Structured Warning / Callout Items within Shared Header */
.reading-warning-group,
.reading-callout-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.reading-warning-item,
.reading-callout-item {
  padding-top: var(--space-2xs);
}

.reading-warning-item + .reading-warning-item,
.reading-callout-item + .reading-callout-item {
  border-top: 1px dashed var(--line);
  padding-top: var(--space-sm);
  margin-top: var(--space-2xs);
}

.reading-concept-heading {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text);
