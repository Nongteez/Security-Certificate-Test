        {
          "kind": "table",
          "caption": {
            "en": "The questions behind AAA",
            "th": "คำถามเบื้องหลัง AAA"
          },
          "columns": [
            {
              "en": "Function",
              "th": "หน้าที่"
            },
            {
              "en": "Question",
              "th": "คำถาม"
