        "isc2-outline",
        "d1-knowledge",
        "d1-transcript"
      ],
      "blocks": [
        {
          "kind": "text",
          "text": {
            "en": "The same authenticated account can receive different access decisions.",
            "th": "บัญชีที่ยืนยันตัวตนแล้วบัญชีเดียวกัน อาจได้รับผลการตรวจสิทธิ์ต่างกัน"
          }
