    {
      "id": "slide-04-activity-trail",
      "title": {
        "en": "Leave a trail that can be reviewed.",
        "th": "บันทึกร่องรอย เพื่อให้ตรวจสอบย้อนหลังได้"
      },
      "layoutId": "aaa-accounting",
