    {
      "id": "slide-03-permission-boundary",
      "title": {
        "en": "Signed in does not mean allowed.",
        "th": "เข้าสู่ระบบแล้ว ไม่ได้แปลว่าทำได้ทุกอย่าง"
      },
      "layoutId": "aaa-permission",
      "rendererId": "comparison",
