/* ==========================================================================
   Quiz Screen Styles — SEC CERT TEST
   Responsive, Dark/Light theme, Touch-friendly options & Bilingual Typography
   ========================================================================== */

.quiz-container {
  max-width: 1100px;
  width: 100%;
  margin: 0 auto;
  padding: 0 0 60px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Header & Controls */
.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}

.quiz-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.quiz-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quiz-cert-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--panel-2);
  border: 1px solid var(--line);
  padding: 6px 12px;
  border-radius: 100px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
}

.quiz-mode-pill {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 700;
}

.quiz-mode-pill.practice {
  background: var(--blue-bg);
  color: var(--blue);
  border: 1px solid rgba(58, 134, 255, 0.3);
}

.quiz-mode-pill.exam {
  background: var(--gold-bg);
  color: var(--gold);
  border: 1px solid rgba(244, 197, 66, 0.3);
}

.quiz-timer-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--panel);
  border: 1px solid var(--line);
  padding: 6px 14px;
  border-radius: 100px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
}

.quiz-timer-badge.exam-timer {
  color: var(--gold);
  border-color: rgba(244, 197, 66, 0.3);
  background: var(--gold-bg);
}

.quiz-timer-badge.low-time {
  color: var(--red);
  border-color: rgba(230, 57, 70, 0.4);
  background: var(--red-bg);
  animation: pulse 1s infinite alternate;
}

@keyframes pulse {
  from { opacity: 0.85; }
  to { opacity: 1; }
}

.btn-finish-quiz {
  padding: 10px 18px;
  font-size: 14.5px;
  font-weight: 600;
  border-radius: 8px;
  white-space: nowrap;
  transition: all 0.15s ease;
}

.btn-finish-quiz.practice {
  background: var(--blue-bg);
  border: 1px solid rgba(58, 134, 255, 0.35);
  color: var(--blue);
}

.btn-finish-quiz.practice:hover {
  background: rgba(58, 134, 255, 0.2);
  border-color: var(--blue);
}

.btn-finish-quiz.exam {
  background: var(--gold-bg);
  border: 1px solid rgba(244, 197, 66, 0.4);
  color: var(--gold);
}

.btn-finish-quiz.exam:hover {
  background: rgba(244, 197, 66, 0.22);
  border-color: var(--gold);
}

.modal-btn-row {
  display: flex;
  gap: 10px;
  margin-top: 18px;
  width: 100%;
}

.modal-btn-row .btn {
  flex: 1;
  padding: 11px 16px;
  font-size: 14px;
  min-height: 42px;
}

.modal-warn-box {
  background: var(--red-bg);
  border: 1px solid rgba(230, 57, 70, 0.3);
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 16px;
  color: var(--red);
  font-size: 13px;
  text-align: left;
  line-height: 1.45;
}

/* Progress & Meta Bar */
.quiz-meta-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  width: 100%;
}

.quiz-meta-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
}

.quiz-question-counter,
.quiz-progress-text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  flex-shrink: 0;
}

.domain-pill {
  display: inline-flex;
  align-items: center;
  background: var(--blue-bg);
  border: 1px solid rgba(58, 134, 255, 0.35);
  color: var(--blue);
  padding: 3px 11px;
  border-radius: 100px;
  font-family: 'JetBrains Mono', 'Space Grotesk', 'Noto Sans Thai', monospace, sans-serif;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1.3;
  white-space: nowrap;
}

/* Compact Segmented Score Component (Practice Mode) */
.quiz-score-segment {
  display: inline-flex;
  align-items: center;
  background: var(--panel-2);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-sm, 8px);
  padding: 4px 6px;
  font-family: 'JetBrains Mono', 'Noto Sans Thai', monospace, sans-serif;
  font-size: 14px;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: var(--card-shadow);
  user-select: none;
}

.score-segment-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 12px;
  font-size: 14px;
}

.score-segment-item .score-icon {
  font-weight: 700;
  font-size: 13px;
}

.score-segment-correct .score-icon {
  color: var(--green);
}

.score-segment-correct .score-val {
  color: var(--text);
  font-weight: 700;
}

.score-segment-wrong .score-icon {
  color: var(--red);
}

.score-segment-wrong .score-val {
  color: var(--text);
  font-weight: 700;
}

.score-segment-item .score-label {
  color: var(--text-dim);
  font-size: 13px;
  font-weight: 500;
}

.score-segment-divider {
  width: 1px;
  height: 18px;
  background: var(--line);
  margin: 0 2px;
}

.quiz-meta-actions {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  white-space: nowrap;
}

.quiz-progress-track {
  width: 100%;
  height: 6px;
  background: var(--panel-2);
  border-radius: 100px;
  overflow: hidden;
  border: 1px solid var(--line);
}

.quiz-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--blue), #60a5fa);
  border-radius: 100px;
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Main Question Card */
.question-card {
  background: var(--panel);
  border: 1.5px solid var(--line);
  border-radius: var(--radius);
  padding: 32px 36px 36px;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 18px;
  transition: border-color 0.2s ease;
}

.question-text-block {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.question-en {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.5;
  color: var(--text);
}

.question-th {
  font-size: 16.5px;
  font-weight: 500;
  line-height: 1.6;
  color: var(--text-dim);
}

.lang-badge {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  margin-right: 6px;
  background: var(--panel-2);
  border: 1px solid var(--line);
  color: var(--text-muted);
  vertical-align: middle;
}

/* Option Items */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 18px;
  background: var(--panel-2);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-sm);
  cursor: pointer;
  text-align: left;
  color: var(--text);
  font-family: inherit;
  font-size: 15px;
  line-height: 1.45;
  transition: all 0.18s ease;
  user-select: none;
  width: 100%;
}

.option-item:hover:not(:disabled) {
  border-color: var(--blue);
  background: var(--panel-hover);
  transform: translateY(-1px);
}

.option-item:active:not(:disabled) {
  transform: translateY(0);
}

.option-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  min-width: 28px;
  border-radius: 6px;
  background: var(--panel);
  border: 1px solid var(--line);
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-dim);
  transition: all 0.18s ease;
}

.option-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.option-text-en {
  font-weight: 500;
  color: var(--text);
}

.option-text-th {
  font-size: 14px;
  color: var(--text-dim);
  line-height: 1.5;
}

/* Option States */
.option-item.selected {
  border-color: var(--blue);
  background: var(--blue-bg);
}

.option-item.selected .option-letter {
  background: var(--blue);
  color: #ffffff;
  border-color: var(--blue);
}

.option-item.correct {
  border-color: var(--green) !important;
  background: var(--green-bg) !important;
}

.option-item.correct .option-letter {
  background: var(--green) !important;
  color: #ffffff !important;
  border-color: var(--green) !important;
}

.option-item.wrong {
  border-color: var(--red) !important;
  background: var(--red-bg) !important;
}

.option-item.wrong .option-letter {
  background: var(--red) !important;
  color: #ffffff !important;
  border-color: var(--red) !important;
}

.option-item:disabled {
  cursor: default;
}

/* Explanation Box (Practice Mode) */
.explanation-box {
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-left: 4px solid var(--blue);
  border-radius: var(--radius-sm);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  animation: fadeIn 0.25s ease-out;
}

.explanation-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--blue);
  letter-spacing: 0.05em;
}

.explanation-en {
  font-size: 14.5px;
  line-height: 1.65;
  color: var(--text);
}

.explanation-divider {
  height: 1px;
  background: var(--line);
  margin: 4px 0;
  opacity: 0.75;
}

.explanation-th {
  font-size: 14px;
  line-height: 1.65;
  color: var(--text-dim);
}

/* ===== 2026 Structured Explanation Layout (next-bank only) — Minimal Neutral Theme ===== */
.exp-2026-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.exp-single-lang-wrap {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.exp-lang-block {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.exp-lang-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11.5px;
  font-weight: 700;
  color: var(--text-dim);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* Base minimal section: neutral, borderless, separated by subtle neutral dividers */
.exp-section {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* Subtle neutral divider between consecutive sections */
.exp-section + .exp-section {
  border-top: 1px solid var(--line);
  padding-top: 16px;
  margin-top: 16px;
}

/* Section titles */
.exp-section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.01em;
}

/* Prominent Correct Answer Title */
.exp-correct-section .exp-section-title {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--text);
}

/* Status Icons */
.exp-status-icon {
  font-size: 13.5px;
  font-weight: 800;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* Green checkmark beside Correct Answer */
.exp-status-correct {
  color: var(--green);
}

/* Red cross beside Why Other Options Are Incorrect */
.exp-status-incorrect {
  color: var(--red);
}

/* Prominent Correct Option quote */
.exp-option-quote {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
  padding-left: 22px;
}

/* Explanation body */
.exp-section-body {
  font-size: 14px;
  line-height: 1.65;
  color: var(--text-dim);
  padding-left: 22px;
}

.exp-correct-section .exp-section-body {
  color: var(--text);
}

/* Incorrect options list: clean rows without nested card borders */
.exp-incorrect-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 6px;
  padding-left: 22px;
}

.exp-incorrect-item {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.exp-incorrect-item:first-child {
  padding-top: 4px;
}

.exp-incorrect-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.exp-incorrect-header {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}

/* Plain-text option letter label A, B, C, D (clean, unbadged, aligned) */
.exp-letter-tag {
  font-family: inherit;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text-dim);
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  letter-spacing: normal;
  flex-shrink: 0;
  line-height: inherit;
}

.exp-incorrect-option-text {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text);
}

.exp-incorrect-body {
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--text-dim);
}

/* Optional Sections (Examples & Exam Tips): minimal, neutral, no colored left borders or tints */
.exp-example-section,
.exp-tip-section {
  background: transparent;
  border: none;
}

/* Paragraph and bullet formatting */
.exp-bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--text-dim);
  margin-bottom: 4px;
}

.exp-bullet {
  color: var(--text-muted);
  font-weight: 700;
}

.exp-p {
  margin: 0 0 6px 0;
  line-height: 1.6;
}

.exp-p:last-child {
  margin-bottom: 0;
}


/* Bottom Action Bar */
.quiz-actions-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  padding-top: 10px;
}

.quiz-actions-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quiz-actions-right {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: auto;
}

.btn-quiz-exit {
  padding: 7px 14px;
  font-size: 13px;
  min-height: 34px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  border-radius: var(--radius-sm, 8px);
}

/* Animation */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Mobile & Tablet Responsiveness */
@media (max-width: 768px) {
  .quiz-container {
    padding-bottom: 40px;
    gap: 16px;
  }

  /* 1. Header: 2 clean rows */
  .quiz-header {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding-bottom: 12px;
  }

  .quiz-header-left {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 8px;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .btn-quiz-exit {
    padding: 6px 12px;
    font-size: 12px;
    min-height: 32px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .quiz-cert-badge {
    padding: 4px 10px;
    font-size: 11.5px;
    min-height: 32px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .quiz-mode-pill {
    padding: 2px 6px;
    font-size: 10.5px;
  }

  .quiz-header-right {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 6px;
    min-width: 0;
  }

  /* Push lang-toggle + theme-toggle to right if timer is not present (e.g. results/review) */
  .quiz-header-right > .lang-toggle:first-child {
    margin-left: auto;
  }

  .quiz-timer-badge {
    padding: 4px 9px;
    font-size: 11.5px;
    min-height: 32px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .lang-toggle {
    padding: 2px;
    min-height: 32px;
    align-items: center;
    flex-shrink: 0;
  }

  .lang-btn {
    padding: 4px 8px;
    font-size: 11px;
    min-height: 26px;
  }

  .quiz-header .theme-toggle {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .quiz-header .theme-toggle svg {
    width: 15px;
    height: 15px;
  }

  /* 2. Quiz Status Area: Domain + Counter above, Score + Finish below */
  .quiz-meta-bar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    width: 100%;
  }

  .quiz-meta-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
  }

  .domain-pill {
    padding: 3.5px 10px;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.35;
    border-radius: 100px;
    max-width: 100%;
    white-space: normal;
    word-break: break-word;
    text-align: left;
  }

  .quiz-question-counter,
  .quiz-progress-text {
    font-size: 13px;
  }

  .quiz-meta-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 8px;
    min-width: 0;
  }

  .quiz-meta-actions > .btn-finish-quiz:only-child {
    margin-left: auto;
  }

  .quiz-score-segment {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 4px;
    border-radius: 8px;
    font-size: 12px;
    flex-shrink: 0;
  }

  .score-segment-item {
    padding: 0 8px;
    font-size: 12px;
    gap: 5px;
    display: inline-flex;
    align-items: center;
  }

  .score-segment-item .score-icon {
    font-size: 12px;
  }

  .score-segment-item .score-val {
    font-size: 12px;
    font-weight: 700;
  }

  .score-segment-item .score-label {
    font-size: 11px;
  }

  .score-segment-divider {
    height: 16px;
    margin: 0 1px;
  }

  .btn-finish-quiz {
    height: 34px;
    padding: 0 14px;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .quiz-progress-track {
    height: 6px;
    border-radius: 100px;
    margin-top: -2px;
  }

  /* 3. Question Card */
  .question-card {
    padding: 20px 16px;
    gap: 16px;
    border-radius: var(--radius, 14px);
  }

  .question-en {
    font-size: 16px;
    line-height: 1.5;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .question-th {
    font-size: 15px;
    line-height: 1.55;
    word-break: break-word;
    overflow-wrap: anywhere;
    margin-top: 4px;
  }

  /* 4. Options */
  .option-item {
    padding: 12px 14px;
    gap: 12px;
    min-height: 48px;
    font-size: 14.5px;
    border-radius: var(--radius-sm, 8px);
  }

  .option-letter {
    width: 28px;
    height: 28px;
    min-width: 28px;
    font-size: 12.5px;
    flex-shrink: 0;
    border-radius: 6px;
  }

  .option-content {
    flex: 1;
    min-width: 0;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .option-text-en {
    font-size: 14.5px;
    line-height: 1.45;
  }

  .option-text-th {
    font-size: 13.5px;
    line-height: 1.5;
    margin-top: 3px;
  }

  /* 5. Explanation */
  .explanation-box {
    padding: 14px 16px;
    gap: 8px;
    border-radius: var(--radius-sm, 8px);
    border-left-width: 3.5px;
  }

  .explanation-header {
    font-size: 11.5px;
  }

  .explanation-en,
  .explanation-th {
    font-size: 13.5px;
    line-height: 1.6;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .explanation-divider {
    height: 1px;
    margin: 3px 0;
  }

  .exp-section {
    padding: 0;
    gap: 6px;
  }

  .exp-section + .exp-section {
    padding-top: 14px;
    margin-top: 14px;
  }

  .exp-section-title {
    font-size: 13px;
  }

  .exp-correct-section .exp-section-title {
    font-size: 14px;
  }

  .exp-option-quote,
  .exp-section-body,
  .exp-incorrect-list {
    padding-left: 0;
  }

  .exp-section-body {
    font-size: 13px;
    line-height: 1.55;
  }

  .exp-incorrect-item {
    padding: 8px 0;
    gap: 3px;
  }

  .exp-incorrect-body {
    font-size: 12.5px;
  }

  .exp-letter-tag {
    font-size: 13px;
    padding: 0;
  }

  /* 6. Action Bar: Both Previous / Next on one row with flex: 1 */
  .quiz-actions-bar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding-top: 4px;
  }

  .quiz-actions-left,
  .quiz-actions-right {
    flex: 1;
    margin: 0;
    width: 50%;
  }

  .quiz-actions-left .btn,
  .quiz-actions-right .btn {
    width: 100%;
    min-height: 44px;
    padding: 10px 10px;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }
}

/* Narrow Phones (<= 430px, 390px, 375px) */
@media (max-width: 430px) {
  .quiz-container {
    gap: 14px;
  }

  .quiz-header-left {
    gap: 6px;
  }

  .btn-quiz-exit {
    padding: 5px 10px;
    font-size: 11.5px;
    min-height: 30px;
  }

  .quiz-cert-badge {
    padding: 4px 8px;
    font-size: 11px;
    min-height: 30px;
    gap: 4px;
  }

  .quiz-mode-pill {
    padding: 2px 5px;
    font-size: 10px;
  }

  .quiz-timer-badge {
    padding: 4px 7px;
    font-size: 11px;
    min-height: 30px;
  }

  .lang-toggle {
    padding: 2px;
    min-height: 30px;
  }

  .lang-btn {
    padding: 3px 6px;
    font-size: 10.5px;
    min-height: 24px;
  }

  .quiz-header .theme-toggle {
    width: 30px;
    height: 30px;
  }

  .quiz-header .theme-toggle svg {
    width: 14px;
    height: 14px;
  }

  .domain-pill {
    padding: 3px 8px;
    font-size: 11px;
  }

  .quiz-question-counter,
  .quiz-progress-text {
    font-size: 12.5px;
  }

  .quiz-meta-actions {
    gap: 6px;
  }

  .quiz-score-segment {
    height: 32px;
    padding: 0 3px;
    font-size: 11px;
  }

  .score-segment-item {
    padding: 0 6px;
    font-size: 11px;
    gap: 3.5px;
  }

  .score-segment-item .score-icon {
    font-size: 11px;
  }

  .score-segment-item .score-label {
    font-size: 10px;
  }

  .btn-finish-quiz {
    height: 32px;
    padding: 0 10px;
    font-size: 11.5px;
  }

  .question-card {
    padding: 16px 14px;
    gap: 14px;
  }

  .question-en {
    font-size: 15px;
  }

  .question-th {
    font-size: 14px;
  }

  .option-item {
    padding: 10px 12px;
    min-height: 44px;
    gap: 10px;
  }

  .option-letter {
    width: 26px;
    height: 26px;
    min-width: 26px;
    font-size: 12px;
  }

  .option-text-en {
    font-size: 13.5px;
  }

  .option-text-th {
    font-size: 12.5px;
  }

  .explanation-box {
    padding: 12px 12px;
  }

  .explanation-en,
  .explanation-th {
    font-size: 13px;
  }
}
