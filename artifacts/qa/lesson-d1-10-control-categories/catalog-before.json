        {
          "id": "1.1",
          "title": {
            "en": "Understand cybersecurity concepts",
            "th": "เข้าใจแนวคิดด้านความมั่นคงปลอดภัยไซเบอร์"
          },
          "status": "published",
          "lessons": [
            {
              "id": "lesson-d1-01-cia-triad",
              "domainId": 1,
              "primaryObjectiveId": "1.1",
              "objectiveIds": [
                "1.1"
              ],
              "title": {
                "en": "The CIA Triad: Core Information Security Goals",
                "th": "สามเหลี่ยม CIA: เสาหลักแห่งเป้าหมายความมั่นคงปลอดภัยสารสนเทศ"
              },
              "synopsis": {
                "en": "Master the three foundational pillars of information security: Confidentiality, Integrity, and Availability. Learn to diagnose security impacts through real-world enterprise scenarios.",
                "th": "เรียนรู้ 3 เสาหลักพื้นฐานของความมั่นคงปลอดภัยสารสนเทศ ได้แก่ การรักษาความลับ (Confidentiality), ความถูกต้องครบถ้วน (Integrity) และความพร้อมใช้งาน (Availability) พร้อมฝึกวิเคราะห์ผลกระทบจากสถานการณ์จำลองจริง"
              },
              "status": "published",
              "revision": "1",
              "lessonPath": "lessons/lesson-d1-01-cia-triad.json"
            },
            {
              "id": "lesson-d1-02-aaa-mfa",
              "domainId": 1,
              "primaryObjectiveId": "1.1",
              "objectiveIds": [
                "1.1"
              ],
              "title": {
                "en": "Identification, AAA & Multi-Factor Authentication",
                "th": "การระบุตัวตน AAA และ Multi-Factor Authentication"
              },
              "synopsis": {
                "en": "Separate identity claims, credential verification, permissions and activity records. Recognize genuine MFA through a procurement access story.",
                "th": "แยกการอ้างตัวตน การตรวจหลักฐาน สิทธิ์ และบันทึกกิจกรรม พร้อมจำแนก MFA ผ่านสถานการณ์ระบบจัดซื้อ"
              },
              "status": "published",
              "revision": "1",
              "lessonPath": "lessons/lesson-d1-02-aaa-mfa.json"
            },
            {
              "id": "lesson-d1-03-non-repudiation",
              "domainId": 1,
              "primaryObjectiveId": "1.1",
              "objectiveIds": [
                "1.1"
              ],
              "title": {
                "en": "Non-repudiation & Trustworthy Evidence",
                "th": "Non-repudiation และหลักฐานที่น่าเชื่อถือ"
              },
              "synopsis": {
                "en": "Explain how signatures and well-managed evidence support review of disputed actions—and what they cannot prove alone.",
                "th": "เรียนรู้ว่าลายเซ็นและการจัดการหลักฐานช่วยตรวจการกระทำที่ถูกโต้แย้งอย่างไร พร้อมข้อจำกัด"
              },
              "status": "published",
              "revision": "1",
              "lessonPath": "lessons/lesson-d1-03-non-repudiation.json"
            },
            {
              "id": "lesson-d1-04-privacy",
              "domainId": 1,
              "primaryObjectiveId": "1.1",
              "objectiveIds": [
                "1.1"
              ],
              "title": {
                "en": "Privacy & Personal Data",
                "th": "Privacy และข้อมูลส่วนบุคคล"
              },
              "synopsis": {
                "en": "Make responsible decisions about personal data—from purpose and roles to inventory, retention and erasure.",
                "th": "ตัดสินใจจัดการข้อมูลส่วนบุคคล ตั้งแต่วัตถุประสงค์และบทบาท จนถึง Inventory, Retention และการลบ"
              },
              "status": "published",
              "revision": "1",
              "lessonPath": "lessons/lesson-d1-04-privacy.json"
            }
