 }
 /* End Phase 3B.2 scoped typography. */
 
+/* Phase 3C: content-driven Reading tables and intact technical words. */
+.reading-body .reading-table-wrapper {
+  max-width: 100%;
+  scrollbar-width: auto;
+  scrollbar-color: var(--text-muted) var(--panel-2);
+}
+.reading-body .reading-table-wrapper:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: 2px;
+}
+.reading-body .reading-table {
+  table-layout: auto;
+  min-width: min-content;
+}
+.reading-body .reading-table th,
+.reading-body .reading-table td {
+  word-break: normal;
+  overflow-wrap: normal;
+  hyphens: manual;
+}
+/* A readable floor for comparisons, without prescribing column proportions.
+   Two-column tables retain their natural sizing; existing document roles win. */
+.reading-body .reading-table:has(th:nth-child(3)) th {
+  min-width: 9rem;
+}
+.reading-body .reading-table .reading-term-en,
+.reading-body .reading-table .reading-term-en strong {
+  white-space: normal;
+}
+/* GRC's fixed percentages plus a nowrap keyword exceeded padded cell bounds.
+   Let each column participate in native min-content sizing, as other tables do. */
+.reading-body .reading-table-grc-frameworks th:nth-child(n),
+.reading-body .reading-table-grc-frameworks td:nth-child(n) {
+  width: auto;
+  min-width: 9rem;
+}
+.reading-body .reading-table-grc-frameworks td.reading-col-exam-keyword strong {
+  white-space: normal;
+}
+/* Risk-card badges must yield space rather than fragment the English title. */
+.reading-body .reading-treatment-header {
+  flex-wrap: wrap;
+}
+.reading-body .reading-treatment-title-group {
+  flex: 1 1 16rem;
+  min-width: 0;
+}
+.reading-body .reading-treatment-title {
+  word-break: normal;
+  overflow-wrap: normal;
+}
+.reading-body .reading-scenario-header {
+  flex-wrap: wrap;
+}
+.reading-body .reading-scenario-badge {
+  flex-shrink: 0;
+  word-break: normal;
+  overflow-wrap: normal;
+}
+.reading-body .reading-scenario-topic {
+  word-break: normal;
+  overflow-wrap: normal;
+}
+/* End Phase 3C scoped tables. */
+
 /* Phase 3B.3: content-aware widths within published Reading Notes only. */
 .app:has(.reading-structured-objective) {
   max-width: 1560px;
