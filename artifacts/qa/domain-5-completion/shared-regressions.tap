                en: 'Recognize manipulation, distinguish source techniques and apply safe verification, reporting and credential protection.'
                th: 'รู้ทันการชักจูง แยกเทคนิคตามต้นฉบับ และใช้การตรวจ รายงาน กับปกป้อง Credential อย่างเหมาะสม'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d2-06-social-engineering-password-protection.json'
          relatedLessonIds:
        3:
          id: '2.4'
          title:
            en: 'Measure cybersecurity effectiveness'
            th: 'วัดประสิทธิผลของความปลอดภัยไซเบอร์'
          status: 'published'
          lessons:
            0:
              id: 'lesson-d2-07-security-metrics-kpi-kri'
              domainId: 2
              primaryObjectiveId: '2.4'
              objectiveIds:
                0: '2.4'
              title:
                en: 'Security Metrics, KPIs & KRIs'
                th: 'Security Metrics, KPI และ KRI'
              synopsis:
                en: 'Define useful measures, interpret time and percentage metrics, and distinguish performance from risk evidence.'
                th: 'กำหนด Metric ที่ใช้ได้ ตีความเวลา/เปอร์เซ็นต์ และแยกหลักฐานผลงานจากความเสี่ยง'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d2-07-security-metrics-kpi-kri.json'
            1:
