  actual:
    0:
      id: 1
      name:
        en: 'Security Principles'
        th: 'หลักการความปลอดภัย'
      status: 'published'
      objectives:
        0:
          id: '1.1'
          title:
            en: 'Understand cybersecurity concepts'
            th: 'เข้าใจแนวคิดด้านความมั่นคงปลอดภัยไซเบอร์'
          status: 'published'
          lessons:
            0:
              id: 'lesson-d1-01-cia-triad'
              domainId: 1
              primaryObjectiveId: '1.1'
              objectiveIds:
                0: '1.1'
              title:
                en: 'The CIA Triad: Core Information Security Goals'
                th: 'สามเหลี่ยม CIA: เสาหลักแห่งเป้าหมายความมั่นคงปลอดภัยสารสนเทศ'
              synopsis:
                en: 'Master the three foundational pillars of information security: Confidentiality, Integrity, and Availability. Learn to diagnose security impacts through real-world enterprise scenarios.'
                th: 'เรียนรู้ 3 เสาหลักพื้นฐานของความมั่นคงปลอดภัยสารสนเทศ ได้แก่ การรักษาความลับ (Confidentiality), ความถูกต้องครบถ้วน (Integrity) และความพร้อมใช้งาน (Availability) พร้อมฝึกวิเคราะห์ผลกระทบจากสถานการณ์จำลองจริง'
              status: 'published'
              revision: '4'
              lessonPath: 'lessons/lesson-d1-01-cia-triad.json'
            1:
              id: 'lesson-d1-02-aaa-mfa'
              domainId: 1
              primaryObjectiveId: '1.1'
              objectiveIds:
                0: '1.1'
              title:
                en: 'Identification, AAA & Multi-Factor Authentication'
                th: 'การระบุตัวตน AAA และ Multi-Factor Authentication'
              synopsis:
                en: 'Separate identity claims, credential verification, permissions and activity records. Recognize genuine MFA through a procurement access story.'
                th: 'แยกการอ้างตัวตน การตรวจหลักฐาน สิทธิ์ และบันทึกกิจกรรม พร้อมจำแนก MFA ผ่านสถานการณ์ระบบจัดซื้อ'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-02-aaa-mfa.json'
            2:
              id: 'lesson-d1-03-non-repudiation'
              domainId: 1
              primaryObjectiveId: '1.1'
              objectiveIds:
                0: '1.1'
              title:
                en: 'Non-repudiation & Trustworthy Evidence'
                th: 'Non-repudiation และหลักฐานที่น่าเชื่อถือ'
              synopsis:
                en: 'Explain how signatures and well-managed evidence support review of disputed actions—and what they cannot prove alone.'
                th: 'เรียนรู้ว่าลายเซ็นและการจัดการหลักฐานช่วยตรวจการกระทำที่ถูกโต้แย้งอย่างไร พร้อมข้อจำกัด'
              status: 'published'
              revision: '2'
              lessonPath: 'lessons/lesson-d1-03-non-repudiation.json'
            3:
              id: 'lesson-d1-04-privacy'
              domainId: 1
              primaryObjectiveId: '1.1'
              objectiveIds:
                0: '1.1'
              title:
                en: 'Privacy & Personal Data'
                th: 'Privacy และข้อมูลส่วนบุคคล'
              synopsis:
                en: 'Make responsible decisions about personal data—from purpose and roles to inventory, retention and erasure.'
                th: 'ตัดสินใจจัดการข้อมูลส่วนบุคคล ตั้งแต่วัตถุประสงค์และบทบาท จนถึง Inventory, Retention และการลบ'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-04-privacy.json'
          relatedLessonIds:
        1:
          id: '1.2'
          title:
            en: 'Understand risk management concepts'
            th: 'เข้าใจแนวคิดการบริหารความเสี่ยง'
          status: 'published'
          lessons:
            0:
              id: 'lesson-d1-05-risk-foundations'
              domainId: 1
              primaryObjectiveId: '1.2'
              objectiveIds:
                0: '1.2'
              title:
                en: 'Risk Foundations & Lifecycle'
                th: 'พื้นฐาน Risk และวงจรการบริหารความเสี่ยง'
              synopsis:
                en: 'Connect assets, threats, weaknesses, likelihood and consequences, then follow risk through an ongoing decision cycle.'
                th: 'เชื่อม Asset ภัย จุดอ่อน โอกาสและผลกระทบ แล้วติดตาม Risk ผ่านวงจรตัดสินใจที่ทบทวนต่อเนื่อง'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-05-risk-foundations.json'
            1:
              id: 'lesson-d1-06-assessment'
              domainId: 1
              primaryObjectiveId: '1.2'
              objectiveIds:
                0: '1.2'
              title:
                en: 'Assessment & Prioritization'
                th: 'การประเมินและจัดลำดับความเสี่ยง'
              synopsis:
                en: 'Compare assessment methods, work through single and annual loss estimates, and prioritize without hiding uncertainty.'
                th: 'เปรียบเทียบวิธีประเมิน คำนวณความเสียหายต่อครั้งและต่อปี และจัดลำดับโดยไม่ซ่อนความไม่แน่นอน'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-06-assessment.json'
            2:
              id: 'lesson-d1-07-risk-response'
              domainId: 1
              primaryObjectiveId: '1.2'
              objectiveIds:
                0: '1.2'
              title:
                en: 'Respond, Review & Communicate Risk'
                th: 'ตอบสนอง ทบทวน และสื่อสาร Risk'
              synopsis:
                en: 'Choose and justify risk responses, review what remains and make decisions traceable.'
                th: 'เลือกและให้เหตุผลของวิธีตอบสนอง ทบทวน Risk ที่เหลือ และบันทึกการตัดสินใจให้ติดตามได้'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-07-risk-response.json'
          relatedLessonIds:
        2:
          id: '1.3'
          title:
            en: 'Understand governance concepts'
            th: 'เข้าใจแนวคิดการกำกับดูแล'
          status: 'published'
          lessons:
            0:
              id: 'lesson-d1-08-governance'
              domainId: 1
              primaryObjectiveId: '1.3'
              objectiveIds:
                0: '1.3'
              title:
                en: 'Governance & Applicable Requirements'
                th: 'Governance และข้อกำหนดที่ใช้กับองค์กร'
              synopsis:
                en: 'Connect security direction, oversight and accountability to the requirements that actually apply.'
                th: 'เชื่อมทิศทาง การกำกับติดตาม และความรับผิดชอบด้านความปลอดภัยกับข้อกำหนดที่ใช้จริง'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-08-governance.json'
            1:
              id: 'lesson-d1-09-frameworks'
              domainId: 1
              primaryObjectiveId: '1.3'
              objectiveIds:
                0: '1.3'
              title:
                en: 'Frameworks & Security Documents'
                th: 'Frameworks และเอกสารความปลอดภัย'
              synopsis:
                en: 'Connect security frameworks and standards to policy, requirements, procedures and useful guidance.'
                th: 'เชื่อม Frameworks และมาตรฐานกับนโยบาย ข้อกำหนด ขั้นตอน และคำแนะนำ'
              status: 'published'
              revision: '2'
              lessonPath: 'lessons/lesson-d1-09-frameworks.json'
          relatedLessonIds:
        3:
          id: '1.4'
          title:
            en: 'Understand cybersecurity controls'
            th: 'เข้าใจมาตรการควบคุมความปลอดภัยไซเบอร์'
          status: 'published'
          lessons:
            0:
              id: 'lesson-d1-10-control-categories'
              domainId: 1
              primaryObjectiveId: '1.4'
              objectiveIds:
                0: '1.4'
              title:
                en: 'Control Categories'
                th: 'ประเภทของมาตรการความปลอดภัย'
              synopsis:
                en: 'Distinguish technical, administrative and physical controls by mechanism and apply them together.'
                th: 'แยก Technical, Administrative และ Physical ตามกลไก และใช้ร่วมกันให้เหมาะสม'
              status: 'published'
              revision: '3'
              lessonPath: 'lessons/lesson-d1-10-control-categories.json'
            1:
              id: 'lesson-d1-11-control-functions'
              domainId: 1
              primaryObjectiveId: '1.4'
              objectiveIds:
                0: '1.4'
              title:
                en: 'What Is the Control Doing?'
                th: 'Control นี้ทำหน้าที่อะไร?'
              synopsis:
                en: 'Explain security-control functions, their limits and overlap through contextual examples.'
                th: 'อธิบายหน้าที่ ข้อจำกัด และส่วนทับซ้อนของ Controls จากบริบท'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-11-control-functions.json'
          relatedLessonIds:
        4:
          id: '1.5'
          title:
            en: 'Maintain professional and ethical conduct'
            th: 'รักษาการปฏิบัติตนตามวิชาชีพและจริยธรรม'
          status: 'published'
          lessons:
            0:
              id: 'lesson-d1-12-professional-conduct'
              domainId: 1
              primaryObjectiveId: '1.5'
              objectiveIds:
                0: '1.5'
              title:
                en: 'Professional Conduct & Ethical Decisions'
                th: 'ความประพฤติวิชาชีพและการตัดสินใจเชิงจริยธรรม'
              synopsis:
                en: 'Apply professional boundaries, due care, due diligence and the four ISC2 canons to responsible decisions.'
                th: 'ใช้ขอบเขตวิชาชีพ Due Care, Due Diligence และหลัก ISC2 สี่ข้อในการตัดสินใจที่รับผิดชอบ'
              status: 'published'
