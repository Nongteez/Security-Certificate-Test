              synopsis:
                en: 'Connect responsibilities to approved access, provision it correctly and verify the result for people and automated workloads.'
                th: 'เชื่อมหน้าที่กับสิทธิ์ที่อนุมัติ จัดเตรียมและตรวจผลให้ถูกต้องสำหรับคนและระบบงานอัตโนมัติ'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d3-01-roles-provisioning.json'
            1:
              id: 'lesson-d3-02-review-deprovisioning'
              domainId: 3
              primaryObjectiveId: '3.1'
              objectiveIds:
                0: '3.1'
              title:
                en: 'Access Reviews, Changes & Deprovisioning'
                th: 'ทบทวน ปรับ และถอนสิทธิ์ตลอดวงจรชีวิต'
              synopsis:
                en: 'Reassess changing needs, distinguish activity from ownership and verify authorized access withdrawal for people and workloads.'
                th: 'ทบทวนความจำเป็นที่เปลี่ยน แยกการใช้งานจากความรับผิดชอบ และตรวจผลการถอนสิทธิ์ของคนและระบบงาน'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d3-02-review-deprovisioning.json'
