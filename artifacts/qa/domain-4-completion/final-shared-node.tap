                th: 'เชื่อม Asset ภัย จุดอ่อน โอกาสและผลกระทบ แล้วติดตาม Risk ผ่านวงจรตัดสินใจที่ทบทวนต่อเนื่อง'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-05-risk-foundations.json'
            1:
              id: 'lesson-d1-06-assessment'
              domainId: 1
              primaryObjectiveId: '1.2'
              objectiveIds:
                0: '1.2'
              title:
                en: 'Assessment & Prioritization'
                th: 'การประเมินและจัดลำดับความเสี่ยง'
              synopsis:
                en: 'Compare assessment methods, work through single and annual loss estimates, and prioritize without hiding uncertainty.'
                th: 'เปรียบเทียบวิธีประเมิน คำนวณความเสียหายต่อครั้งและต่อปี และจัดลำดับโดยไม่ซ่อนความไม่แน่นอน'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-06-assessment.json'
            2:
              id: 'lesson-d1-07-risk-response'
              domainId: 1
              primaryObjectiveId: '1.2'
              objectiveIds:
                0: '1.2'
              title:
                en: 'Respond, Review & Communicate Risk'
                th: 'ตอบสนอง ทบทวน และสื่อสาร Risk'
              synopsis:
                en: 'Choose and justify risk responses, review what remains and make decisions traceable.'
                th: 'เลือกและให้เหตุผลของวิธีตอบสนอง ทบทวน Risk ที่เหลือ และบันทึกการตัดสินใจให้ติดตามได้'
              status: 'published'
              revision: '1'
              lessonPath: 'lessons/lesson-d1-07-risk-response.json'
          relatedLessonIds:
