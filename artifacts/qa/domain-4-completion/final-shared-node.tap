              domainId: 3
              primaryObjectiveId: '3.2'
              objectiveIds:
                0: '3.2'
              title:
                en: 'Least Privilege & Separation of Duties'
                th: 'สิทธิ์เท่าที่จำเป็นและการแบ่งแยกหน้าที่'
              synopsis:
                en: 'Grant enough access for the task and separate incompatible authority, including automated work.'
                th: 'ให้สิทธิ์พอทำงานและแยกอำนาจที่ขัดกัน รวมถึงงานอัตโนมัติ'
              status: 'published'
